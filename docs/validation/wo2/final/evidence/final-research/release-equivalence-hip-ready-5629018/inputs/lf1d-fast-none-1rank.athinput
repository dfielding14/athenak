<job>
basename = lf1d


<mesh>
nghost = 2
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic


<meshblock>
nx1 = 128
nx2 = 1
nx3 = 1


<time>
evolution = kinematic
integrator = rk2
sts_integrator = rkl2
sts_max_dt_ratio = 10.0
cfl_number = 0.4
nlim = 4
tlim = 0.099735570100358162
ndiag = 100000


<mhd>
eos = cgl
passive = false
cgl_heat_flux = landau_fluid
cgl_heat_flux_integrator = sts
lf_k_parallel = 6.283185307179586
lf_coefficient_mode = background
lf_c_parallel0 = 1.0
cgl_lf_strict_admissibility = true
reconstruct = plm
rsolver = advect
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10
cgl_lf_profile = false
cgl_lf_profile_detail = false

cgl_lf_arithmetic = fast
cgl_lf_diagnostics = none

<problem>
pgen_name = cgl_landau_fluid
test_mode = parallel_decay
mode_number = 1
rho0 = 1.0
ppar0 = 1.0
pperp0 = 1.0
b0 = 1.0
amp = 1.0e-4
decay_rel_tol = 3.0e-3
phase_rel_tol = 1.0e-6
validation_output = false
validation_output_dir = docs/figures/data


<output1>
file_type = hst
data_format = %24.16e
dcycle = 1

<output2>
file_type = bin
variable = mhd_w_bcc
dcycle = 1000000

<output3>
file_type = rst
dcycle = 1000000
