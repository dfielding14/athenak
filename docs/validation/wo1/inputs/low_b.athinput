# Frozen scratch input for WO1 byte comparison.

<job>
basename = low_b

<mesh>
nghost = 2
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 128
nx2 = 1
nx3 = 1

<time>
evolution = kinematic
integrator = rk2
sts_integrator = rkl2
sts_max_dt_ratio = 10.0
cfl_number = 0.4
nlim = 10
tlim = 1
ndiag = 100000

<mhd>
eos = cgl
passive = false
cgl_heat_flux = landau_fluid
cgl_heat_flux_integrator = sts
lf_k_parallel = 6.283185307179586
lf_coefficient_mode = background
lf_c_parallel0 = 1.0
cgl_lf_strict_admissibility = true
reconstruct = plm
rsolver = advect
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10
cgl_lf_profile = true
cgl_lf_profile_detail = false

<problem>
pgen_name = cgl_landau_fluid
test_mode = low_field
mode_number = 1
rho0 = 1.0
ppar0 = 1.0
pperp0 = 1.0
b0 = 5e-11
amp = 0.5
decay_rel_tol = 3.0e-3
phase_rel_tol = 1.0e-6
validation_output = false
validation_output_dir = docs/figures/data

<output1>
file_type = hst
data_format = %24.16e
dcycle = 1

<output2>
file_type = bin
variable = mhd_u_bcc
dcycle = 10

<output3>
file_type = bin
variable = mhd_w_bcc
dcycle = 10

<output4>
file_type = rst
dcycle = 10
