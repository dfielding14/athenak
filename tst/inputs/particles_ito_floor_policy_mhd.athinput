# AthenaK input for flux-tracer MHD floor-policy tests

<comment>
problem = Ito tracer MHD floor policy

<job>
basename = particles_ito_floor_policy_mhd

<mesh>
nghost = 2
nx1 = 8
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 4
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 1
tlim = 1.0
ndiag = 1

<mhd>
eos = ideal
gamma = 1.6666666666666667
dfloor = 0.5
sigma_max = 100.0
reconstruct = plm
rsolver = llf

<particles>
particle_type = lagrangian_ito
pusher = ito2
ito_order = 2
tracer_kick_pdf = uniform
random_seed = 12345

<problem>
pgen_name = linear_wave
wave_flag = 0
amp = 0.0
dens = 1.0
pgas = 0.6
vx0 = 0.5
vy0 = 0.0
vz0 = 0.0
bx0 = 1.0
by0 = 1.4142135623730951
bz0 = 0.5
along_x1 = true
along_x2 = false
along_x3 = false
