# Error-function diffusion tests reuse the stationary shock_tube step.
<job>
basename = STSDiffusion

<mesh>
nghost = 2
nx1 = 64
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = -1
tlim = 0.0005
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.6666666666666667
viscosity = 0.0
conductivity = 0.0
tdep_conductivity = false
sat_hflux = false

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
dr = 1.0
pr = 1.0
ur = 0.0
vr = 0.0
wr = 0.0
bxl = 0.0
byl = 0.0
bzl = 0.0
bxr = 0.0
byr = 0.0
bzr = 0.0

<output1>
file_type = bin
variable = hydro_u
id = state
data_precision = real
dcycle = 1
