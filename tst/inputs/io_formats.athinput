# Focused shared-output producer for PDF and spherical-slice regression tests.

<job>
basename = io_formats

<mesh>
nghost = 2
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 8
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.8
nlim = 1
tlim = 0.01
ndiag = 1
output_timing = false
final_output_policy = none

<hydro>
eos = ideal
reconstruct = plm
rsolver = llf
gamma = 1.4

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
dr = 0.125
pr = 0.1
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = pdf
id = nd3
variable_1 = coord_r
nbin1 = 4
bin1_min = 0.01
bin1_max = 1.0
scale1 = log
variable_2 = coord_abscostheta
nbin2 = 4
bin2_min = 0.0
bin2_max = 1.0
scale2 = linear
variable_3 = vel_sph_r
nbin3 = 4
bin3_min = -1.0
bin3_max = 1.0
scale3 = symlog
linthresh3 = 0.1
weight = mass
single_file_per_rank = false
dt = 1.0

<output2>
file_type = sphslice
id = density
variable = hydro_w_d
slice_r = 0.25
ntheta = 4
nphi = 8
single_file_per_rank = false
dt = 1.0

<output3>
file_type = pdf
id = legacy
variable = hydro_w_d
bin_min = 0.0
bin_max = 2.0
nbin = 8
logscale = false
mass_weighted = false
dt = 1.0

<output4>
file_type = sph
id = legacy_surface
variable = hydro_w_d
radius = 0.25
ntheta = 4
dt = 1.0
