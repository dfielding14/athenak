# MHD resistivity and viscosity with RKL2 STS and shearing-periodic boundaries.

<job>
basename = mhd_sts_sbox

<mesh>
nghost = 2
nx1 = 16
x1min = -0.25
x1max = 0.25
ix1_bc = shear_periodic
ox1_bc = shear_periodic
nx2 = 16
x2min = -0.25
x2max = 0.25
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -0.25
x3max = 0.25
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
tlim = 0.30
nlim = -1
ndiag = 100000
sts_integrator = rkl2
sts_max_dt_ratio = -1.0

<shearing_box>
qshear = 1.5
omega0 = 1.0

<mhd>
eos = isothermal
reconstruct = plm
rsolver = hlle
iso_sound_speed = 1.0
viscosity = 0.1
viscosity_integrator = sts
ohmic_resistivity = 0.2
ohmic_resistivity_integrator = sts

<problem>
pgen_name = shwave
ipert = 4
d0 = 1.0
amp = 1.0e-4
nwx = -2
nwy = 1
nwz = 1
beta = 20.0

<output1>
file_type = bin
variable = mhd_w_bcc
dt = 0.30

<output2>
file_type = bin
variable = mhd_divb
dt = 0.30

<output3>
file_type = rst
dt = 0.28125
