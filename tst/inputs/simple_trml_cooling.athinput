# Small deterministic input for simple_TRML cooling-accounting regressions.

<job>
basename = SimpleTRMLCooling

<mesh>
nghost = 3
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 1
tlim = 0.001
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666666666667
nscalars = 1
fofc = true
dfloor = 1.0e-8
pfloor = 1.0e-10

<problem>
rho_hot = 1.0
rho_cold = 1.0
velocity = 0.0
pres = 1.0
t_cool_min = 0.05
T_cutoff_over_T_cold = 10.0
T_ci_over_T_cold = 1.5
T_ih_over_T_cold = 2.5
beta = 0.0
custom_min_timestep = 0.001
user_srcs = true
user_dt = true
user_hist = true
user_bcs = false
phase_sharpness = 10.0
max_init_perturb_log2freq = 1
min_init_perturb_log2freq = 1
init_perturb_sharpness = 10.0
init_perturb_vel_frac = 0.0

<output1>
file_type = hst
data_format = %24.16e
dt = 1.0e-20
