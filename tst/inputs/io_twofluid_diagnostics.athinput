# Negative regression: unqualified generic flux diagnostics are ambiguous for two-fluid runs.

<job>
basename = io_twofluid

<mesh>
nghost = 3
nx1 = 16
x1min = -1.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = imex3
cfl_number = 0.3
nlim = 1
tlim = 1.0e-3
ndiag = 1

<ion-neutral>
drag_coeff = 1.0

<hydro>
eos = isothermal
reconstruct = plm
rsolver = hlle
iso_sound_speed = 1.0

<mhd>
eos = isothermal
reconstruct = plm
rsolver = hlle
iso_sound_speed = 1.0

<problem>
pgen_name = cshock
shock_dir = 1
di0 = 1.0e-3
dn0 = 1.0
vix0 = 20.0
vnx0 = 20.0
viy0 = 20.0
vny0 = 20.0
bx0 = 2.83
by0 = 2.83
pert = 1.0e-5

<output1>
file_type = pdf
id = ambiguous_flux
variable_1 = mdot_sph
nbin1 = 8
bin1_min = -1.0
bin1_max = 1.0
scale1 = linear
weight = volume
dt = 1.0
