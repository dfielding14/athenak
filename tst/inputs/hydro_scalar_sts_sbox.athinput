# Passive-scalar diffusion with RKL2 STS and shearing-periodic radial boundaries.

<job>
basename = hydro_scalar_sts_sbox

<mesh>
nghost = 2
nx1 = 16
x1min = -0.25
x1max = 0.25
ix1_bc = shear_periodic
ox1_bc = shear_periodic
nx2 = 16
x2min = -0.25
x2max = 0.25
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -0.25
x3max = 0.25
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 4

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
tlim = 0.30
nlim = -1
ndiag = 100000
sts_integrator = rkl2
sts_max_dt_ratio = -1.0

<shearing_box>
qshear = 1.5
omega0 = 1.0

<hydro>
eos = isothermal
reconstruct = plm
rsolver = hlle
iso_sound_speed = 1.0
nscalars = 1
scalar_diffusivity = 0.1
scalar_diffusivity_integrator = sts

<problem>
pgen_name = advection
advect_dens = false
flow_dir = 2
iproblem = 1
velocity = 0.0
amplitude = 0.2

<output1>
file_type = bin
variable = hydro_u_s
dt = 0.30
