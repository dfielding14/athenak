# AthenaK input for MHD particle-field sampling regression tests

<comment>
problem = MHD thermodynamic-history field sampling

<job>
basename = particle_field_sampling_mhd

<mesh>
nghost = 3
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 4
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 1
tlim = 1.0
ndiag = 1

<mhd>
eos = ideal
reconstruct = plm
rsolver = llf
gamma = 1.6666666666666667

<particles>
particle_type = lagrangian_ito
pusher = ito2
ito_order = 2
tracer_kick_pdf = uniform
random_seed = 161803

<tracer_seed1>
id = 1
start_time = 0.0
end_time = 0.0
cadence = -1.0
count_per_event = 2048
weight = mass
region = all
seed = 141421

<problem>
pgen_name = linear_wave
wave_flag = 0
amp = 0.01
dens = 1.0
pgas = 0.6
vx0 = 0.4
vy0 = 0.0
vz0 = 0.0
bx0 = 1.0
by0 = 1.4142135623730951
bz0 = 0.5
along_x1 = true
along_x2 = false
along_x3 = false

<output1>
file_type = prtcl_thermo_history
id = cell
dt = 1.0
variables = density, v1, b1, b2, b3, bmag, beta, alfven_speed

<output2>
file_type = prtcl_thermo_history
id = cic
dt = 1.0
variables = density, v1, b1, b2, b3, bmag, beta, alfven_speed
particle_field_sampling = cic

<output3>
file_type = tab
id = mesh
variable = mhd_w_bcc
data_format = %24.17e
dt = 1.0
slice_x2 = 0.0
slice_x3 = 0.0
