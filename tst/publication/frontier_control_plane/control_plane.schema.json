{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athenak.example.invalid/frontier-pic-control-plane.schema.json",
  "title": "Frontier PIC immutable pre-submit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_plane_version",
    "control_plane_inventory",
    "submission_id",
    "pic_root",
    "campaign",
    "test_id",
    "submission_scope",
    "job_script_executable_env",
    "launch_contract",
    "git_commit",
    "evidence_class",
    "physical_mode",
    "selected_qos",
    "qos_selection_reason",
    "site_policy_checked_utc",
    "registered_short_nonproduction",
    "artifact_dir",
    "queue_snapshot_sha256",
    "timeout_margin",
    "snapshot_files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "control_plane_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "control_plane_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control_plane_inventory_record"
      }
    },
    "pic_root": {
      "const": "/lustre/orion/ast207/proj-shared/dfielding/PIC"
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "campaign": {
      "type": "string",
      "minLength": 1
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "submission_scope": {
      "enum": [
        "registered_science",
        "frontier_admission_smoke"
      ]
    },
    "job_script_executable_env": {
      "const": "PIC_EXECUTABLE"
    },
    "launch_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "executor",
        "pre_actions",
        "actions",
        "post_actions"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "executor": {
          "const": "trusted_trampoline_athena_argv_v1"
        },
        "pre_actions": {
          "$ref": "#/$defs/bounded_actions"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/launch_action"
          }
        },
        "post_actions": {
          "$ref": "#/$defs/bounded_actions"
        }
      }
    },
    "clean_candidate_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "clean_candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registered_science_authorization_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "pre_manifest_attestation_path": {
      "type": "string",
      "minLength": 1
    },
    "pre_manifest_attestation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prior_case_closures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prior_case_closure"
      }
    },
    "planner_retention": {
      "$ref": "#/$defs/planner_retention"
    },
    "git_commit": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "type": "string",
      "minLength": 1
    },
    "physical_mode": {
      "type": "string",
      "minLength": 1
    },
    "selected_qos": {
      "enum": [
        "debug",
        "normal"
      ]
    },
    "qos_selection_reason": {
      "enum": [
        "debug_available",
        "debug_slot_occupied",
        "debug_ineligible_production",
        "debug_ineligible_walltime",
        "normal_required_by_registered_campaign"
      ]
    },
    "site_policy_checked_utc": {
      "type": "string",
      "format": "date-time"
    },
    "registered_short_nonproduction": {
      "type": "boolean"
    },
    "artifact_dir": {
      "type": "string",
      "minLength": 1
    },
    "queue_snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "timeout_margin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "athena_walltime_seconds",
        "scheduler_walltime_seconds",
        "environment_profile_sha256",
        "measured_utc",
        "expires_utc"
      ],
      "properties": {
        "athena_walltime_seconds": {
          "$ref": "#/$defs/positive_integer"
        },
        "scheduler_walltime_seconds": {
          "$ref": "#/$defs/positive_integer"
        },
        "environment_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "measured_utc": {
          "type": "string",
          "format": "date-time"
        },
        "expires_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "snapshot_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/snapshot_file_record"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "control_plane_inventory_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "snapshot_file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "source_path",
        "source_sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "planner_retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "retention_role",
        "planner_root",
        "planner_inventory_sha256",
        "planner_plan_id",
        "planner_materialization_receipt",
        "attempt_id",
        "authorized_orion_attempt_root",
        "authorized_orion_raw_root",
        "argv"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "retention_role": {
          "const": "q011_section54_deterministic_retained_attempt"
        },
        "planner_root": {
          "type": "string",
          "minLength": 1
        },
        "planner_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "planner_plan_id": {
          "$ref": "#/$defs/sha256"
        },
        "planner_materialization_receipt": {
          "$ref": "#/$defs/control_plane_inventory_record"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "authorized_orion_attempt_root": {
          "type": "string",
          "minLength": 1
        },
        "authorized_orion_raw_root": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prior_case_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "submission_id",
        "artifact_dir",
        "descriptor_path",
        "descriptor_sha256",
        "reconciliation_event_sha256"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]{0,63}$"
        },
        "submission_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_dir": {
          "type": "string",
          "minLength": 1
        },
        "descriptor_path": {
          "type": "string",
          "minLength": 1
        },
        "descriptor_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reconciliation_event_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "launch_argument": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_role"
          ],
          "properties": {
            "snapshot_role": {
              "const": "input-deck"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_directory"
          ],
          "properties": {
            "artifact_directory": {
              "$ref": "#/$defs/artifact_path"
            }
          }
        }
      ]
    },
    "launch_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "kind",
        "resources",
        "arguments",
        "stdout_artifact",
        "stderr_artifact"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "const": "athena"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "tasks",
            "cpus_per_task",
            "gpus_per_task",
            "gpu_bind"
          ],
          "properties": {
            "nodes": {
              "$ref": "#/$defs/positive_integer"
            },
            "tasks": {
              "$ref": "#/$defs/positive_integer"
            },
            "cpus_per_task": {
              "$ref": "#/$defs/positive_integer"
            },
            "gpus_per_task": {
              "$ref": "#/$defs/positive_integer"
            },
            "gpu_bind": {
              "const": "closest"
            }
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/launch_argument"
          }
        },
        "stdout_artifact": {
          "$ref": "#/$defs/artifact_path"
        },
        "stderr_artifact": {
          "$ref": "#/$defs/artifact_path"
        }
      }
    },
    "bounded_actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "snapshot_sha256"
              },
              "snapshot_role": {
                "type": "string",
                "pattern": "^(job-script|executable|input-deck|environment-profile|timeout-margin|queue-snapshot|analysis-script-[0-9]{3})$"
              },
              "output_artifact": {
                "$ref": "#/$defs/artifact_path"
              }
            },
            "required": [
              "action_id",
              "kind",
              "snapshot_role",
              "output_artifact"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "artifact_sha256"
              },
              "artifact": {
                "$ref": "#/$defs/artifact_path"
              },
              "output_artifact": {
                "$ref": "#/$defs/artifact_path"
              }
            },
            "required": [
              "action_id",
              "kind",
              "artifact",
              "output_artifact"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "artifact_nonempty"
              },
              "artifact": {
                "$ref": "#/$defs/artifact_path"
              }
            },
            "required": [
              "action_id",
              "kind",
              "artifact"
            ]
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "submission_scope": {
            "const": "registered_science"
          }
        }
      },
      "then": {
        "required": [
          "clean_candidate_manifest_path",
          "clean_candidate_manifest_sha256",
          "registered_science_authorization_id",
          "pre_manifest_attestation_path",
          "pre_manifest_attestation_sha256",
          "prior_case_closures"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "clean_candidate_manifest_path"
              ]
            },
            {
              "required": [
                "clean_candidate_manifest_sha256"
              ]
            },
            {
              "required": [
                "registered_science_authorization_id"
              ]
            },
            {
              "required": [
                "pre_manifest_attestation_path"
              ]
            },
            {
              "required": [
                "pre_manifest_attestation_sha256"
              ]
            },
            {
              "required": [
                "prior_case_closures"
              ]
            },
            {
              "required": [
                "planner_retention"
              ]
            }
          ]
        }
      }
    }
  ]
}
