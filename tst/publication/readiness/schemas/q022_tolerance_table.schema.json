{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenak_pic_q022_tolerance_table.schema.json",
  "title": "AthenaK PIC Q-022 comparison tolerance table",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "dataset_provenance_id",
    "freeze_status",
    "observable_families",
    "rows",
    "blocked_inputs",
    "reviewer_disposition"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "comparison_id": {"type": "string", "minLength": 1},
    "dataset_provenance_id": {"type": "string", "minLength": 1},
    "freeze_status": {
      "enum": [
        "blocked_pending_reference_dataset_extraction_and_external_review",
        "blocked_pending_external_review",
        "not_applicable_documented_exclusion_candidate",
        "draft_open",
        "frozen_before_qualifying_run"
      ]
    },
    "observable_families": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observable",
          "units",
          "reference_value_or_extraction",
          "expected_discretization_trend",
          "absolute_tolerance",
          "relative_tolerance",
          "tolerance_rationale",
          "cpu_mpi_gpu_reduction_variation",
          "failure_artifact_path"
        ],
        "properties": {
          "observable": {"type": "string", "minLength": 1},
          "units": {"type": "string", "minLength": 1},
          "reference_value_or_extraction": {"type": "string", "minLength": 1},
          "expected_discretization_trend": {"type": "string", "minLength": 1},
          "absolute_tolerance": {"type": "number", "minimum": 0},
          "relative_tolerance": {"type": "number", "minimum": 0},
          "tolerance_rationale": {"type": "string", "minLength": 1},
          "cpu_mpi_gpu_reduction_variation": {"type": "string", "minLength": 1},
          "failure_artifact_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "blocked_inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reviewer_disposition": {
      "enum": ["pending external review", "qualified", "rejected", "limited"]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["freeze_status"],
        "properties": {
          "freeze_status": {"const": "frozen_before_qualifying_run"}
        }
      },
      "then": {
        "properties": {
          "rows": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "required": ["freeze_status"],
        "properties": {
          "freeze_status": {
            "enum": [
              "blocked_pending_reference_dataset_extraction_and_external_review",
              "blocked_pending_external_review",
              "not_applicable_documented_exclusion_candidate"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "blocked_inputs": {"minItems": 1},
          "reviewer_disposition": {"const": "pending external review"}
        }
      }
    }
  ],
  "additionalProperties": true
}
