{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenak_pic_q022_equation_normalization_map.schema.json",
  "title": "AthenaK PIC Q-022 equation and normalization map",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "reference_ids",
    "athenak_physical_mode",
    "matched_equations",
    "intentional_mismatches",
    "unit_map",
    "normalization_map",
    "parameter_overlap",
    "excluded_regimes",
    "reviewer_disposition"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "comparison_id": {"type": "string", "minLength": 1},
    "reference_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "athenak_physical_mode": {"type": "string", "minLength": 1},
    "matched_equations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "intentional_mismatches": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "unit_map": {"type": "object", "minProperties": 1},
    "normalization_map": {"type": "object", "minProperties": 1},
    "parameter_overlap": {"type": "object", "minProperties": 1},
    "excluded_regimes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source_records": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reviewer_disposition": {
      "enum": ["pending external review", "qualified", "rejected", "limited"]
    }
  },
  "additionalProperties": true
}
