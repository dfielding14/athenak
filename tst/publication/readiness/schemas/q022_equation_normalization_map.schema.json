{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenak_pic_q022_equation_normalization_map.schema.json",
  "title": "AthenaK PIC Q-022 equation and normalization map",
  "type": "object",
  "required": [
    "schema_version",
    "map_status",
    "comparison_id",
    "dataset_provenance_id",
    "reference_ids",
    "athenak_physical_mode",
    "matched_equations",
    "intentional_mismatches",
    "unit_map",
    "normalization_map",
    "parameter_overlap",
    "excluded_regimes",
    "source_records",
    "blocked_inputs",
    "reviewer_disposition"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "map_status": {
      "enum": [
        "blocked_pending_reference_specific_mapping_and_external_review",
        "documented_exclusion_candidate_pending_external_review",
        "bounded_map_recorded_external_review_open",
        "frozen_before_comparison_run"
      ]
    },
    "comparison_id": {"type": "string", "minLength": 1},
    "dataset_provenance_id": {"type": "string", "minLength": 1},
    "reference_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "athenak_physical_mode": {"type": "string", "minLength": 1},
    "matched_equations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "intentional_mismatches": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "unit_map": {"type": "object"},
    "normalization_map": {"type": "object"},
    "parameter_overlap": {"type": "object"},
    "excluded_regimes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "blocked_inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reviewer_disposition": {
      "enum": ["pending external review", "qualified", "rejected", "limited"]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["map_status"],
        "properties": {
          "map_status": {
            "enum": [
              "bounded_map_recorded_external_review_open",
              "frozen_before_comparison_run"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "matched_equations": {"minItems": 1},
          "unit_map": {"minProperties": 1},
          "normalization_map": {"minProperties": 1},
          "parameter_overlap": {"minProperties": 1}
        }
      }
    },
    {
      "if": {
        "required": ["map_status"],
        "properties": {
          "map_status": {
            "enum": [
              "blocked_pending_reference_specific_mapping_and_external_review",
              "documented_exclusion_candidate_pending_external_review"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "blocked_inputs": {"minItems": 1},
          "reviewer_disposition": {"const": "pending external review"}
        }
      }
    }
  ],
  "additionalProperties": true
}
