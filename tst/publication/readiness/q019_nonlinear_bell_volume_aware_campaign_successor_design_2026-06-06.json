  "normalization_contract": {
    "deposited_quantity": "raw_prtcl_j_represents_J_CR_over_c",
    "exact_general_closure": "PPC*deposit_qscale*species_charge*v_CR/V_root_cell=J_CR/c=2*B0*k0",
    "general_deposit_qscale_derivation": "deposit_qscale=2*B0*k0*V_root_cell/(PPC*species_charge*v_CR)",
    "root_cell_volume": "V_root_cell=product_d((xmax_d-xmin_d)/nx_d)_over_all_three_root_mesh_axes_including_invariant_carrier_axes",
    "ppc_semantics": "macro_particles_per_root_grid_cell",
    "deposit_qscale_semantics": "extensive_root_grid_macro_charge_and_macro_mass_scale",
    "species_charge_semantics": "configured_species_charge_coefficient_used_by_the_deposition_contract",
    "q_over_mc_specialization": {
      "allowed_only_if": "species_mass_equals_1_is_explicitly_bound",
      "specialized_closure": "PPC*deposit_qscale*(q/(mc))*v_CR/V_root_cell=J_CR/c=2*B0*k0",
      "bare_q_over_mc_in_general_closure_allowed": false
    },
    "artificial_light_speed_in_target": false,
    "artificial_light_speed_in_qscale_derivation": false,
    "fixed_qscale_across_dimension_resolution_or_PPC": false,
    "required_initial_raw_output_checks": [
      "cell_volume_weighted_volume_average_of_guide_projected_prtcl_j_equals_2_B0_k0",
      "cell_volume_weighted_volume_average_of_transverse_prtcl_j_is_zero_within_preregistered_tolerance",
      "Q043_raw_cycle_one_prtcl_j_pass_receipt_is_bound",
      "measured_initial_prtcl_j_is_invariant_across_dimension_resolution_PPC_and_decomposition",
      "configured_and_measured_current_targets_are_independent_of_artificial_C"
    ],
    "must_fail_if": [
      "V_root_cell_is_absent",
      "artificial_C_multiplies_the_deposited_current_target",
      "a_fixed_deposit_qscale_is_reused_after_dimension_resolution_or_PPC_changes",
      "only_deck_arithmetic_or_generator_preflight_is_available",
      "the_output_level_current_oracle_does_not_pass"
    ]
  },
