# Base state for the 192 x 192 x 256 elongated CGL+LF+STS AMR validation.

<job>
basename = cgl_amr192_base

<mesh>
nghost = 2
nx1 = 192
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 192
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 256
x3min = -0.6666666666666666
x3max = 0.6666666666666666
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 48
nx2 = 48
nx3 = 64

<time>
evolution = dynamic
integrator = rk2
sts_integrator = rkl2
sts_max_dt_ratio = -1.0
cfl_number = 0.3
nlim = -1
tlim = 1.0
ndiag = 10

<mhd>
eos = cgl
passive = false
cgl_heat_flux = landau_fluid
cgl_heat_flux_integrator = sts
cgl_lf_profile = false
cgl_lf_profile_detail = false
cgl_lf_diagnostics = none
cgl_lf_arithmetic = fast
cgl_lf_sts_flux = physical
cgl_lf_strict_admissibility = true
cgl_lf_record_pressure_work = false
lf_k_parallel = 4.71238898038469
lf_coefficient_mode = local
nu_coll = 0.0
mirror_limiter = true
firehose_limiter = true
cgl_firehose_threshold = parallel
limiter_nu_coll = 1.0e10
limiter_hardwall = true
backup_limiters = false
reconstruct = plm
rsolver = hlle
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10

<problem>
pgen_name = cgl_lf_paper
user_hist = true
paper_mode = turbulence
passive_delta = false
rho0 = 1.0
b0 = 0.565685424949238
beta0 = 6.25
p_parallel0 = 1.0
p_perp0 = 1.0
analysis_t_start = 0.0
analysis_t_end = 1.0

<turb_driving>
normalization = edot
dedt = 0.25
tcorr = 1.0
dt_update = 0.01
nlow = 1
npeak = 2
nhigh = 3
min_kz = 1
spectrum = parabolic
driving_type = 0
projection_policy = solenoidal_compressive
sol_fraction = 1.0
physical_k_shell = true
k_shell_unit = 4.71238898038469
rseed = 914
record_injected_work = true

<output1>
file_type = hst
data_format = %24.16e
dt = 0.01

<output2>
# Shared checkpoints allow the AMR continuation to change MPI rank count.
file_type = rst
dt = 0.25
single_file_per_rank = false

<output3>
file_type = bin
variable = mhd_w_bcc
dt = 1.0
id = threshold_state
single_file_per_rank = true
