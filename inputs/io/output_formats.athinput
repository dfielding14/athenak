# Runnable shared-output example for N-D PDFs, spherical slices, and legacy sph output.
# Analyze generated files with:
#   python vis/python/examples/read_io_outputs.py pdf <path/to/io_formats.00000.pdf>
#   python vis/python/examples/read_io_outputs.py sphslice <path/to/*.sph.bin>

<job>
basename = io_formats

<mesh>
nghost = 2
nx1 = 16
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 16
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.8
nlim = 2
tlim = 0.02
ndiag = 1
performance_timing = false
final_output_policy = all

<hydro>
eos = ideal
reconstruct = plm
rsolver = llf
gamma = 1.4

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
dr = 0.125
pr = 0.1
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = pdf
id = nd3
variable_1 = coord_r
nbin1 = 24
bin1_min = 0.01
bin1_max = 1.0
scale1 = log
variable_2 = coord_abscostheta
nbin2 = 12
bin2_min = 0.0
bin2_max = 1.0
scale2 = linear
variable_3 = vel_sph_r
nbin3 = 20
bin3_min = -1.0
bin3_max = 1.0
scale3 = symlog
linthresh3 = 0.01
weight = mass
single_file_per_rank = false
dt = 0.01

<output2>
file_type = sphslice
id = density
variable = hydro_w_d
slice_r = 0.25
ntheta = 32
nphi = 64
single_file_per_rank = false
dt = 0.01

<output3>
file_type = sph
id = legacy_surface
variable = hydro_w_d
radius = 0.25
ntheta = 32
dt = 0.01
