<comment>
problem = GOTHAM

<job>
basename = gotham

<mesh>
nghost = 4
nx1 = 384
x1min = -200.0
x1max = 200.0
ix1_bc = user
ox1_bc = user
nx2 = 384
x2min = -200.0
x2max = 200.0
ix2_bc = user
ox2_bc = user
nx3 = 384
x3min = -200.0
x3max = 200.0
ix3_bc = user
ox3_bc = user

<mesh_refinement>
refinement = adaptive
num_levels = 9
refinement_interval = 10
ncycle_check = 10
max_nmb_per_rank = 384

<refinement1>
level = 8
x1min = -10.0
x1max = 10.0
x2min = -10.0
x2max = 10.0
x3min = -2.5
x3max = 2.5

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 10.0
ndiag = 100

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.66666667
cgm_cooling = true
cgm_cooling_limit_dt = false
hrate = 2e-26
hscale_norm = 1347.6541799847946
hscale_radius = 0.9402361259893334
hscale_height = 0.04950000000848683
pfloor = 1e-6
dfloor = 1e-6
sfloor = 1e-8
tfloor = 0.0013925
T_max = 5e8
fofc = true
nscalars = 3

<problem>
user_srcs = true
profile_file = tables/cgm_profiles.txt
r_circ = 10.0
v_circ = 9.525240390388422
ddens_max = 2.0
metallicity = 0.333333333333333333333333333333
cgm_turb_nlow = 16
cgm_turb_nhigh = 64
cgm_turb_rms = 1.0
cgm_turb_xscale = 10.0
cgm_turb_yscale = 10.0
cgm_turb_zscale = 10.0
initialize_disk = false

<potential>
r_scale = 11.605294024177795
rho_scale = 2.1743800601559324
mass_gal = 6547.387043624801
scale_gal = 1.4691189466064514
z_gal = 0.15
r_200 = 144.76736317842207
rho_mean = 2.5759499304527406e-05

<particles>
particle_type = star
star_prtcl_rst_flag = 0
star_particle_file = tables/clusters.txt
pusher = rk4_gravity

<SN>
r_inj = 0.008
delay = 10.0

<dust>
d_z_init = 0.2
d_z_sn = 0.2
a_gr_s = 0.003
a_gr_l = 0.1
rho_gr = 3
D_floor = 1e-7
accretion_nH_min = 0.1
accretion_nH_max = 1.0e3
accretion_T_max = 1.0e4
accretion_refractory_frac = 0.1

<turb_driving>
type = hydro
turb_flag = 2
dt_turb_update = 0.001
tcorr = 0.02
dedt = 2500
x_turb_scale_height = 1.0
y_turb_scale_height = 1.0
z_turb_scale_height = 0.1
nlow = 8
nhigh = 10
spect_form = 1
npeak = 9
sol_fraction = 0.5
tile_driving = true
tile_factor = 384

<units>
length_cgs = 3.0856775809623245e+21
mass_cgs = 3.036951775493658e+39
time_cgs = 3.15576e+15
mu = 0.62

<output1>
file_type = hst
dt = 0.01

<output2>
file_type = bin
variable = hydro_w
dt = 5.0
single_file_per_rank = true

<output3>
file_type = bin
variable = hydro_w
dt = 0.1
slice_x1 = 0.0
id = slice_x1
single_file_per_rank = true

