# Deterministic survivor-identity regression for simultaneous MPI migration and escape.

<comment>
problem   = particle send and physical-destruction compaction identity

<job>
basename  = pic_migration_destruction_compaction

<mesh>
nghost    = 2
nx1       = 16
x1min     = 0.0
x1max     = 2.0
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 4
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 4
nx2       = 4
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.75
nlim       = 1
tlim       = 1.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.6666666666666667

<particles>
particle_type                   = cosmic_ray
ppc                             = 3.0
pusher                          = drift
nspecies                        = 3
cr_distribution                 = center
assign_tag                      = index_order
deposit_moments                 = false
deposit_qscale                  = 1.0
couple_moments_to_mhd           = false
couple_moments_momentum_to_mhd  = false
couple_moments_energy_to_mhd    = false
cr_vx0                          = 0.0
cr_vy0                          = 0.0
cr_vz0                          = 0.0
pic_background_mode             = coupled
pic_feedback_mode               = test_particle
pic_max_cell_cross              = 1

# Negative species outnumber the positive species.  On MPI rank 1 this produces eight
# sends, four receives, and four outer-boundary destructions in one migration call.  The
# final positive particle (tag 191) is one of the destruction holes.
<species0>
mass   = 1.0
charge = 1.0
vx0    = -4.0

<species1>
mass   = 1.0
charge = 1.0
vx0    = -4.0

<species2>
mass   = 1.0
charge = 1.0
vx0    = 4.0

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-8
vflow     = 0.0
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type = pvtk
variable  = prtcl_all
id        = prtcl_all
dcycle    = 1
