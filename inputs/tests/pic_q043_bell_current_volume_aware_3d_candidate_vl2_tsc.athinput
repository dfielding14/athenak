# Q-043 VOLUME-AWARE BELL CURRENT SUCCESSOR SOURCE-LOCAL PREPARATION ONLY.
# This non-authorized deck supersedes Q023-PAPER-BELL-LINEAR for qualification
# because that campaign omitted root-cell volume and multiplied by artificial C.
# The uniquely named Q043 foundational pgen requires separate source review.

<comment>
problem   = Q043-BELL-CURRENT-VOLUME-AWARE 3D source-local corrected preparation

<job>
basename  = pic_q043_bell_current_volume_aware_3d_candidate

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 4.58257569495584
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 64
x2min     = 0.0
x2max     = 2.29128784747792
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 32
x3min     = 0.0
x3max     = 1.14564392373896
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.1
nlim       = 0
tlim       = 0.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<particles>
particle_type                     = cosmic_ray
ppc                               = 1.0
pusher                            = boris_tsc
nspecies                          = 1
cr_distribution                   = center
deposit_moments                   = true
deposit_order                     = 2
deposit_qscale                    = 36.71039184344202
couple_moments_to_mhd             = true
couple_j_to_efield_coeff          = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode          = cc_convert
couple_moments_momentum_to_mhd    = true
couple_moments_energy_to_mhd      = true
couple_fluid_feedback_order       = mhd_src_terms
couple_moments_momentum_coeff     = 1.0
couple_moments_energy_coeff       = 1.0
cr_vx0                            = 0.545544725589981
cr_vy0                            = 1.09108945117996
cr_vz0                            = 2.18217890235992
pic_physical_mode                 = paper_mhd_pic_vl2_tsc
pic_background_mode               = coupled
pic_feedback_mode                 = coupled
pic_interp_scheme                 = tsc
pic_enable_2d3v                   = true
pic_cr_light_speed                = 2500.0
pic_cr_initial_state              = velocity
pic_cr_hall_mode                  = off
pic_wave_damping_mode             = off
pic_max_cell_cross                = 1
pic_theta_max                     = 0.3
pic_deltaf_mode                   = off
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval                 = 0
pic_intermediate_arrays           = auto
pic_expanding_box_mode            = off

<species0>
mass   = 1.0
charge = 6.283185307179586e-6

<problem>
pgen_name = q043_bell_current_volume_aware

<q043_bell_current_volume_aware>
campaign_id          = Q043-BELL-CURRENT-VOLUME-AWARE
supersedes_campaign_id = Q023-PAPER-BELL-LINEAR
deck_role            = source_local_corrected_preparation_not_authorized
dimension            = 3
source_mode          = corrected_linear_eigenmode
epsilon_default      = 0.4
epsilon              = 0.4
epsilon_grid         = 0.1,0.2,0.4,0.6,0.8
rho                  = 1.0
pressure             = 1.0
amplitude            = 1.0e-6
b_g                  = 1.0
u_a                  = 1.0
wavelength           = 1.0
k0                   = 6.283185307179586
omega                = 6.283185307179586e-6
c_over_v_cr          = 1000.0
initial_eigenmode    = section52_right_polarized_eigenmode
current_normalization = deposited_j_over_c_equals_2_b_g_k0
deposition_measure    = ppc_times_deposit_qscale_times_species_charge_times_v_cr_over_root_cell_volume
root_cell_volume      = global_root_mesh_extents_over_global_root_mesh_counts
deposit_qscale_semantics = root_cell_macro_charge_volume_aware
fixed_qscale          = forbidden_across_dimensions_and_resolutions
q_over_mc_representation = species_charge_equals_q_over_mc_only_with_explicit_species_mass_equals_1
supersession_effect  = historical_c_multiplied_normalization_invalid_for_qualification
qualification_effect = none_source_local_preparation_only
launch_authorized    = false
timestep             = open_clean_candidate_timestep_freeze

<output1>
file_type   = bin
variable    = mhd_w_bcc
id          = mhd_w_bcc
dcycle      = 1
ghost_zones = false

<output2>
file_type   = bin
variable    = prtcl_rho
id          = prtcl_rho
dcycle      = 1
ghost_zones = false

<output3>
file_type   = bin
variable    = prtcl_jx
id          = prtcl_jx
dcycle      = 1
ghost_zones = false

<output4>
file_type   = bin
variable    = prtcl_jy
id          = prtcl_jy
dcycle      = 1
ghost_zones = false

<output5>
file_type   = bin
variable    = prtcl_jz
id          = prtcl_jz
dcycle      = 1
ghost_zones = false

<output6>
file_type   = rst
id          = rst
dcycle      = 1
single_file_per_rank = false
