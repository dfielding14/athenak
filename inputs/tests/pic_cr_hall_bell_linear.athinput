# Compact volume-aware Bell validation for pic_cr_hall_mode=full.
# Runtime overrides select the Hall-off control and the nx1=320 repeat.

<comment>
problem = full CR-Hall linear Bell validation, Lambda approximately one

<job>
basename = pic_cr_hall_bell_linear

<mesh>
nghost = 2
nx1 = 160
x1min = 0.0
x1max = 5.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 40
nx2 = 4
nx3 = 1

<time>
evolution = dynamic
integrator = vl2
cfl_number = 0.2
nlim = -1
tlim = 1.2
ndiag = 20

<mhd>
eos = ideal
reconstruct = plm
rsolver = llf
gamma = 1.6666666666666667

<particles>
particle_type = cosmic_ray
ppc = 2.0
pusher = boris_tsc
nspecies = 1
cr_distribution = center
deposit_moments = true
deposit_order = 2
deposit_qscale = 78.125
couple_moments_to_mhd = true
couple_j_to_efield_coeff = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode = cc_convert
couple_moments_momentum_to_mhd = true
couple_moments_energy_to_mhd = true
couple_fluid_feedback_order = mhd_src_terms
couple_moments_momentum_coeff = 1.0
couple_moments_energy_coeff = 1.0
cr_vx0 = 100.0
cr_vy0 = 0.0
cr_vz0 = 0.0
pic_background_mode = coupled
pic_feedback_mode = coupled
pic_interp_scheme = tsc
pic_enable_2d3v = true
pic_cr_light_speed = 100000.0
pic_cr_initial_state = velocity
pic_cr_hall_mode = full
pic_background_ion_q_over_mc = 12.44070690821558
pic_wave_damping_mode = off
pic_max_cell_cross = 2
pic_theta_max = 0.3
pic_deltaf_mode = off
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval = 0
pic_intermediate_arrays = auto
pic_expanding_box_mode = off

<species0>
mass = 1.0
charge = 6.283185307179586e-6
vx0 = 100.0
vy0 = 0.0
vz0 = 0.0

<problem>
pgen_name = q043_bell_current_volume_aware

<q043_bell_current_volume_aware>
campaign_id = Q043-BELL-CURRENT-VOLUME-AWARE
supersedes_campaign_id = Q023-PAPER-BELL-LINEAR
deck_role = compact_full_cr_hall_validation
dimension = 1
source_mode = corrected_linear_eigenmode
epsilon_default = 0.01
epsilon = 0.01
epsilon_grid = 0.1,0.2,0.4,0.6,0.8
rho = 1.0
pressure = 1.0
amplitude = 1.0e-7
b_g = 1.0
u_a = 1.0
wavelength = 1.0
k0 = 6.283185307179586
seed_wavenumber = 5.026548245743669
omega = 6.283185307179586e-6
c_over_v_cr = 1000.0
initial_eigenmode = section52_positive_current_unstable_eigenmode
current_normalization = deposited_j_over_c_equals_2_b_g_k0
deposition_measure = ppc_times_deposit_qscale_times_species_charge_times_v_cr_over_root_cell_volume
root_cell_volume = global_root_mesh_extents_over_global_root_mesh_counts
deposit_qscale_semantics = root_cell_macro_charge_volume_aware
fixed_qscale = forbidden_across_dimensions_and_resolutions
q_over_mc_representation = species_charge_equals_q_over_mc_only_with_explicit_species_mass_equals_1
timestep = open_clean_candidate_timestep_freeze

<output1>
file_type = hst
dt = 0.02
data_format = %.17e

<output2>
file_type = bin
variable = mhd_w_bcc
id = mhd_w_bcc
dt = 0.02
ghost_zones = false

<output3>
file_type = bin
variable = prtcl_rho
id = prtcl_rho
dt = 0.2
ghost_zones = false

<output4>
file_type = bin
variable = prtcl_jx
id = prtcl_jx
dt = 0.2
ghost_zones = false

<output5>
file_type = bin
variable = prtcl_jy
id = prtcl_jy
dt = 0.2
ghost_zones = false

<output6>
file_type = bin
variable = prtcl_jz
id = prtcl_jz
dt = 0.2
ghost_zones = false
