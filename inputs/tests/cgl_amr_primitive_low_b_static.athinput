# Pure-CGL static coarse/fine low-field case for boundary repair accounting.

<job>
basename = cgl_amr_primitive_low_b_static

<mesh>
nghost = 2
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<mesh_refinement>
refinement = static
prolong_primitives = true
max_nmb_per_rank = 128

<refined_region1>
level = 1
x1min = 0.25
x1max = 0.75
x2min = 0.0
x2max = 1.0
x3min = 0.0
x3max = 1.0

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.1
nlim = 1
tlim = 0.01
ndiag = 1

<mhd>
eos = cgl
passive = false
reconstruct = plm
rsolver = hlle
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10

<problem>
pgen_name = divb_amr
user_hist = true
rho0 = 1.0
ppar0 = 8.0
pperp0 = 12.0
vx0 = 0.02
vy0 = 0.0
vz0 = 0.0
guide_b1 = 0.0
guide_b2 = 0.0
guide_b3 = 0.0
field_amp = 0.0
field_k = 1.0

<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
user_hist_only = false
