# Focused configuration test for model-selected Spitzer conduction.

<job>
basename = conduction_configuration

<mesh>
nghost = 2
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
tlim = 0.005
nlim = -1
ndiag = 100000
sts_integrator = none
sts_max_dt_ratio = -1.0

<hydro>
eos = ideal
gamma = 1.6666666666667
reconstruct = plm
rsolver = hllc
conductivity_model = spitzer
cond_ceiling = 3.402823466e+38
sat_hflux = false
conductivity_integrator = explicit

<units>
length_cgs = 1.0
mass_cgs = 1.0e-8
time_cgs = 1.0
mu = 1.0

<problem>
pgen_name = sts_diffusion
sts_case = thermal_front
pressure = 1.0
tcold = 0.25
thot = 2.0
xcenter = 0.5
front_width = 0.1

<output1>
file_type = tab
variable = hydro_w
data_format = %24.16e
dt = 0.005
slice_x2 = 0.0
slice_x3 = 0.0
