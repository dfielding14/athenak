# Engineering-only closure regression for mixed migration/destruction compaction.
# Neutral CR carriers isolate record movement while exercising the production
# paper-VL2 physical-boundary ledger and restart schema.

<comment>
problem   = repeated rank crossing, physical escape, and restart ledger parity

<job>
basename  = pic_migration_restart_ledger

<mesh>
nghost    = 2
nx1       = 16
x1min     = 0.0
x1max     = 2.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 4
x2min     = 0.0
x2max     = 1.0
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 4
nx2       = 4
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.8
nlim       = 24
tlim       = 10.0
ndiag      = 4

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.6666666666666667

<particles>
particle_type                      = cosmic_ray
ppc                                = 3.0
pusher                             = boris_tsc
pic_enable_2d3v                    = true
nspecies                           = 3
cr_distribution                    = center
assign_tag                         = index_order
track_displacement                 = true
deposit_moments                    = true
deposit_order                      = 2
deposit_qscale                     = 0.0009765625
couple_moments_to_mhd              = true
couple_j_to_efield_coeff           = 1.0
couple_j_to_efield_representation  = cell_centered
couple_j_deposition_mode           = cc_convert
couple_fluid_feedback_order        = mhd_src_terms
couple_moments_momentum_to_mhd     = true
couple_moments_energy_to_mhd       = true
couple_moments_momentum_coeff      = 1.0
couple_moments_energy_coeff        = 1.0
pic_physical_mode                  = paper_mhd_pic_vl2_tsc
pic_background_mode                = coupled
pic_feedback_mode                  = coupled
pic_interp_scheme                  = tsc
pic_cr_light_speed                 = 1000000.0
pic_cr_initial_state               = momentum
pic_cr_hall_mode                   = off
pic_wave_damping_mode              = off
pic_ion_neutral_collision_rate     = 0.0
pic_max_cell_cross                 = 1
pic_theta_max                      = 0.3
pic_deltaf_mode                    = off
pic_deltaf_adapt_mode              = off
pic_deltaf_adapt_interval          = 0.0
pic_expanding_box_mode             = off
pic_sort_interval                  = 0
pic_boundary_conservation_ledger   = true

# Species 0 and 1 survive and repeatedly cross the two MPI ownership ranges.
<species0>
mass   = 1.0
charge = 0.0
vx0    = 4.0
vy0    = 0.0
vz0    = 0.0

<species1>
mass   = 1.0
charge = 0.0
vx0    = -4.0
vy0    = 0.0
vz0    = 0.0

# Species 2 exits outer x2 in four cohorts, before and after the cycle-12 restart.
<species2>
mass   = 1.0
charge = 0.0
vx0    = 0.0
vy0    = 1.6
vz0    = 0.0

<problem>
pgen_name          = pic_migration_restart_ledger
user_work_in_loop  = true

<output1>
file_type = pvtk
variable  = prtcl_all
id        = prtcl_all
dcycle    = 1

<output2>
file_type             = rst
id                    = rst
dcycle                = 24
single_file_per_rank  = false
