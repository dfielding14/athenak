# Test-only one-cycle constant-acceleration invariant for the MHD-PIC VL2 selector.

<comment>
problem = production turbulence source update with PIC VL2 midpoint staging

<job>
basename = turb_driver_uniform_accel_pic_vl2

<mesh>
nghost = 2
nx1 = 8
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 1

<time>
evolution = dynamic
integrator = vl2
cfl_number = 0.4
nlim = 1
tlim = 0.01
ndiag = 1

<mhd>
eos = ideal
reconstruct = plm
rsolver = llf
gamma = 1.6666666666666667

<eos>
iso_sound_speed = 1.0

<coord>
special_rel = false
general_rel = false

<particles>
particle_type = cosmic_ray
ppc = 0.0
pusher = boris_tsc
nspecies = 1
cr_distribution = center
deposit_moments = true
deposit_order = 2
deposit_qscale = 1.0
couple_moments_to_mhd = true
couple_j_to_efield_coeff = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode = cc_convert
couple_moments_momentum_to_mhd = true
couple_moments_energy_to_mhd = true
couple_fluid_feedback_order = mhd_src_terms
couple_moments_momentum_coeff = 1.0
couple_moments_energy_coeff = 1.0
pic_background_mode = coupled
pic_feedback_mode = coupled
pic_interp_scheme = tsc
pic_cr_light_speed = 100.0
pic_cr_initial_state = momentum
pic_cr_hall_mode = off
pic_wave_damping_mode = off
pic_max_cell_cross = 2
pic_theta_max = 0.3
pic_deltaf_mode = off
pic_deltaf_adapt_mode = off
pic_deltaf_adapt_interval = 0.0
pic_sort_interval = 0
pic_intermediate_arrays = auto
pic_enable_2d3v = true
track_displacement = false
pic_expanding_box_mode = off
pic_random_seed = 24680

<species0>
mass = 1.0
charge = 1.0
vx0 = 0.0
vy0 = 0.0
vz0 = 0.0

<problem>
pgen_name = turb_uniform_accel_test
test_rho0 = 1.25
test_pressure0 = 1.0
test_vx0 = 0.25
test_vy0 = 0.5
test_vz0 = 0.0
test_accel_x1 = 4.0
test_accel_x2 = -2.0
test_accel_x3 = 1.0

<turb_driving>
turb_flag = 2
constant_edot = false
tcorr = 0.0
dedt = 0.0
spect_form = 2
expo = 1.6666666666666667
nlow = 1
nhigh = 2
driving_type = 0
sol_fraction = 1.0
dt_turb_update = 0.01
rseed = 24680

<output1>
file_type = hst
dcycle = 1
data_format = %.17e

<output2>
file_type = bin
variable = mhd_u
id = mhd_u
dcycle = 1
ghost_zones = false

<output3>
file_type = bin
variable = turb_force
id = turb_force
dcycle = 1
ghost_zones = false
