# Focused regression for the turb problem generator's zero-base-field option

<comment>
problem = exact zero magnetic field from ifield=0

<job>
basename = TurbZeroField

<mesh>
nghost = 2
nx1 = 16
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.2
nlim = 0
tlim = 0.0
ndiag = 1

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlld
gamma = 1.6666666666666667

<eos>
iso_sound_speed = 1.0

<problem>
pgen_name = turb
d_i = 1.0
d_n = 1.0
beta = 1.0
ifield = 0
user_hist = true

<output1>
file_type = hst
dcycle = 1

<output2>
file_type = bin
variable = mhd_bcc
id = mhd_bcc
dcycle = 1
ghost_zones = false

<output3>
file_type = bin
variable = mhd_divb
id = mhd_divb
dcycle = 1
ghost_zones = false
