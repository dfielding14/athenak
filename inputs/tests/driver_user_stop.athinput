<comment>
problem = Driver user-stop regression

<job>
basename = driver_user_stop

<mesh>
nghost = 2
nx1 = 8
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.2
nlim = -1
tlim = 10.0
ndiag = 1

<hydro>
eos = isothermal
reconstruct = plm
rsolver = advect
iso_sound_speed = 1.0

<problem>
user_work_in_loop = true
advect_dens = true
flow_dir = 1
iproblem = 1
velocity = 1.0
amplitude = 0.1
test_stop_cycle = 2
test_stop_reason_code = 17
test_stop_failure = false

<output1>
file_type = tab
variable = hydro_w
id = state
dt = 100.0
slice_x2 = 0.0
slice_x3 = 0.0
ghost_zones = false

<output2>
file_type = rst
id = checkpoint
dt = 100.0
single_file_per_rank = false
