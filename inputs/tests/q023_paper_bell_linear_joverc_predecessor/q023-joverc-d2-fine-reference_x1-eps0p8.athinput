ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.1
nlim = 2000000
tlim = 1.75
ndiag = 1

<mhd>
eos = ideal
reconstruct = plm
rsolver = llf
gamma = 1.66666666667

<particles>
