# AthenaXXX input file for qualified expanding-MHD adaptive-delta-f damping smoke

<comment>
problem   = Expanding extended-MHD-PIC adaptive delta-f reduced-damping smoke

<job>
basename  = pic_mhd_expanding_box_adaptive_damping_smoke

<mesh>
nghost    = 2
nx1       = 4
x1min     = 0.0
x1max     = 4.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 4
x2min     = 0.0
x2max     = 4.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 4
x3min     = 0.0
x3max     = 4.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 4
nx2       = 4
nx3       = 4

<time>
evolution  = dynamic
integrator = rk1
cfl_number = 0.1
nlim       = 1
tlim       = 1.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<coord>
special_rel = false
general_rel = false

<particles>
particle_type           = cosmic_ray
ppc                     = 1.0
pusher                  = boris_tsc
nspecies                = 2
cr_distribution         = center
deposit_moments         = true
deposit_order           = 1
deposit_qscale          = 1.0
couple_moments_to_mhd   = true
couple_j_to_efield_coeff = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode = cc_convert
couple_moments_momentum_to_mhd = true
couple_moments_energy_to_mhd   = true
couple_fluid_feedback_order    = mhd_src_terms
couple_moments_momentum_coeff  = 1.0
couple_moments_energy_coeff    = 1.0
pic_physical_mode       = extended_mhd_pic
pic_background_mode     = coupled
pic_feedback_mode       = coupled
pic_interp_scheme       = tsc
pic_enable_2d3v         = false
pic_cr_light_speed      = 10.0
pic_cr_initial_state    = momentum
pic_cr_hall_mode        = off
pic_wave_damping_mode   = ion_neutral_friction
pic_ion_neutral_collision_rate = 0.5
pic_max_cell_cross      = 2
pic_theta_max           = 0.3
pic_deltaf_mode         = physical
pic_deltaf_f0           = kappa_aniso
pic_deltaf_p0           = 1.0
pic_deltaf_kappa        = 2.0
pic_deltaf_drift_x1     = 0.0
pic_deltaf_drift_x2     = 0.0
pic_deltaf_drift_x3     = 0.0
pic_deltaf_aniso_x1     = 1.0
pic_deltaf_aniso_x2     = 1.0
pic_deltaf_aniso_x3     = 1.0
pic_deltaf_background_rho = 1.0
pic_deltaf_background_jx  = 0.0
pic_deltaf_background_jy  = 0.0
pic_deltaf_background_jz  = 0.0
pic_deltaf_adapt_mode   = global_bikappa_moments_experimental
pic_deltaf_adapt_interval = 1.0
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval       = 0
pic_intermediate_arrays = auto
pic_expanding_box_mode  = on
pic_expansion_law       = exponential
pic_expansion_rate_x1   = 0.01
pic_expansion_rate_x2   = 0.02
pic_expansion_rate_x3   = 0.03

<species0>
mass   = 1.0
charge = 0.0
vx0    = 1.0
vy0    = 0.5
vz0    = 0.25

<species1>
mass   = 1.0
charge = 0.0
vx0    = -0.5
vy0    = 0.75
vz0    = -0.25

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-6
vflow     = 0.2
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type   = hst
dcycle      = 1
data_format = %20.12e

<output2>
file_type   = bin
variable    = mhd_u
id          = mhd_u
dcycle      = 1
ghost_zones = false

<output3>
file_type   = bin
variable    = mhd_w
id          = mhd_w
dcycle      = 1
ghost_zones = false

<output4>
file_type   = bin
variable    = mhd_bcc
id          = mhd_bcc
dcycle      = 1
ghost_zones = false

<output5>
file_type   = pvtk
variable    = prtcl_all
id          = prtcl_all
dcycle      = 1

<output6>
file_type   = rst
id          = rst
dcycle      = 1
single_file_per_rank = false
