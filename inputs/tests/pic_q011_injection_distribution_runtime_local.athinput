# Q-011 bounded serial-host injection audit only.
# This reduced-domain carrier is not a paper-shock campaign, calibration result,
# AMR check, GPU result, external-review closure, or qualification artifact.

<comment>
problem   = Q011 bounded local shock injection distribution runtime audit

<job>
basename  = pic_q011_injection_distribution_runtime_local

<mesh>
nghost    = 2
nx1       = 8
x1min     = 0.0
x1max     = 8.0
ix1_bc    = reflect
ox1_bc    = inflow

nx2       = 16
x2min     = 0.0
x2max     = 16.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 16
nx3       = 1

<mesh_refinement>
refinement           = none
num_levels           = 1
ddens_max            = 0.0
ncycle_check         = 1
refinement_interval  = 1
max_nmb_per_rank     = 8

<time>
evolution  = dynamic
integrator = rk1
cfl_number = 0.3
nlim       = 1
tlim       = 1.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<coord>
special_rel = false
general_rel = false

<particles>
particle_type                     = cosmic_ray
ppc                               = 0.0
pusher                            = boris_tsc
pic_enable_2d3v                   = true
nspecies                          = 1
cr_distribution                   = random
deposit_moments                   = true
deposit_order                     = 1
deposit_qscale                    = 2.0e-2
couple_moments_to_mhd             = true
couple_j_to_efield_coeff          = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode          = cc_convert
couple_fluid_feedback_order       = mhd_src_terms
couple_moments_momentum_to_mhd    = true
couple_moments_energy_to_mhd      = true
couple_moments_momentum_coeff     = 1.0
couple_moments_energy_coeff       = 1.0
cr_vx0                            = 0.0
cr_vy0                            = 0.0
cr_vz0                            = 0.0
pic_physical_mode                 = paper_mhd_pic
pic_background_mode               = coupled
pic_feedback_mode                 = coupled
pic_interp_scheme                 = tsc
pic_cr_light_speed                = 10000.0
pic_cr_initial_state              = momentum
pic_cr_hall_mode                  = off
pic_wave_damping_mode             = off
pic_ion_neutral_collision_rate    = 0.0
pic_max_cell_cross                = 2
pic_theta_max                     = 0.3
pic_deltaf_mode                   = off
pic_deltaf_adapt_mode             = off
pic_deltaf_adapt_interval         = 0.0
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval                 = 0
pic_intermediate_arrays           = auto
pic_random_seed                   = 11011
pic_expanding_box_mode            = off

<species0>
mass   = 1.0
charge = 1.0

<problem>
pgen_name                     = pic_parallel_shock
ps_rho0                       = 1.0
ps_p0                         = 0.10
ps_u0                         = 30.0
ps_b0                         = 1.0
ps_eta                        = 1.0
ps_vinj_over_u0               = 3.16227766017
ps_inject_half_width_cells    = 0.5
ps_shock_speed_model          = ideal_surface
ps_inject_t_start             = 0.0
ps_inject_t_stop              = 1.0
ps_remove_birth_time_before   = -1.0
ps_enable_injection           = true
ps_enable_gas_subtraction     = false
ps_enable_curvature_amr       = false
ps_inject_species             = 0
ps_inject_seed                = 11011
ps_seed_noise_amp             = 0.0
ps_seed_noise_seed            = 11011
ps_enable_frame_tracking      = false
ps_frame_diag_dcycle          = 1
ps_feedback_diag_dcycle       = 1

<q011_injection_distribution_runtime_local>
audit_role             = bounded_serial_host_runtime_diagnostic_only
qualification_effect   = none
frontier_authorization = not_bound
amr_qualification      = not_claimed
gpu_qualification      = not_claimed
physical_calibration   = not_claimed
external_review        = not_claimed
audit_method           = deterministic_bounded_statistics_not_exact_rng_replay

<output1>
file_type   = pvtk
variable    = prtcl_all
id          = prtcl_all
dcycle      = 1
