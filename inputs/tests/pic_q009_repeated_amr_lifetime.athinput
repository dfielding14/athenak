# BOUNDED Q-009 LOCAL SERIAL-HOST REGRESSION: not qualification evidence.
# Alternating dens_max restart overrides force repeated refine/derefine transitions.

<comment>
problem   = Q-009 bounded repeated AMR cosmic-ray lifetime stress

<job>
basename  = pic_q009_repeated_amr_lifetime

<mesh>
nghost    = 2
nx1       = 8
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 4
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 4
nx2       = 4
nx3       = 1

<mesh_refinement>
refinement           = adaptive
num_levels           = 2
dens_max             = 0.5
ncycle_check         = 1
refinement_interval  = 1
max_nmb_per_rank     = 16

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 2
tlim       = 10.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<particles>
particle_type                  = cosmic_ray
ppc                            = 2.0
pusher                         = drift
nspecies                       = 1
cr_distribution                = random
deposit_moments                = true
deposit_order                  = 1
deposit_qscale                 = 1.0
couple_moments_to_mhd          = false
couple_moments_momentum_to_mhd = false
couple_moments_energy_to_mhd   = false
cr_vx0                         = 4.0
cr_vy0                         = 0.0
cr_vz0                         = 0.0
pic_background_mode            = coupled
pic_feedback_mode              = test_particle
pic_max_cell_cross             = 1
pic_random_seed                = 9009

<species0>
mass   = 1.0
charge = 1.0

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-6
vflow     = 0.0
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type   = pvtk
variable    = prtcl_all
id          = prtcl_all
dcycle      = 1
file_number = 0

<output2>
file_type   = bin
variable    = mhd_w_d
id          = mesh
dcycle      = 1
file_number = 0
ghost_zones = false

<output3>
file_type   = rst
id          = rst
dcycle      = 1
file_number = 0
single_file_per_rank = false
