# Q-029 SOURCE-LOCAL EXTENSION CANDIDATE ONLY: not authorized and not runnable.
# This deck freezes the implemented CT-current source normalization below. The
# q029_extended_hall_normalization_open problem generator remains intentionally
# unavailable until a separately reviewed clean candidate and campaign exist.

<comment>
problem   = Q029 extended Hall CT-current normalization source-local candidate

<job>
basename  = pic_q029_extended_hall_normalization_candidate

<mesh>
nghost    = 2
nx1       = 32
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.1
nlim       = 0
tlim       = 0.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<particles>
particle_type                     = cosmic_ray
ppc                               = 1.0
pusher                            = boris_tsc
nspecies                          = 1
cr_distribution                   = center
deposit_moments                   = true
deposit_order                     = 1
deposit_qscale                    = 1.0
couple_moments_to_mhd             = true
couple_j_to_efield_coeff          = 0.5
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode          = cc_convert
couple_moments_momentum_to_mhd    = true
couple_moments_energy_to_mhd      = true
couple_fluid_feedback_order       = mhd_src_terms
couple_moments_momentum_coeff     = 1.0
couple_moments_energy_coeff       = 1.0
cr_vx0                            = 1.0
cr_vy0                            = 0.0
cr_vz0                            = 0.0
pic_physical_mode                 = extended_mhd_pic
pic_background_mode               = coupled
pic_feedback_mode                 = coupled
pic_interp_scheme                 = tsc
pic_enable_2d3v                   = false
pic_cr_light_speed                = 10.0
pic_cr_initial_state              = momentum
pic_cr_hall_mode                  = current_to_ct_experimental
pic_wave_damping_mode             = off
pic_max_cell_cross                = 1
pic_theta_max                     = 0.3
pic_deltaf_mode                   = off
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval                 = 0
pic_intermediate_arrays           = auto
pic_expanding_box_mode            = off

<species0>
mass   = 1.0
charge = 1.0

<problem>
pgen_name = q029_extended_hall_normalization_open

<q029_hall_extension>
campaign_id             = Q029-EXT-HALL-NORMALIZATION-CANDIDATE
deck_role               = launch_blocked_source_local_normalization_only_not_evidence
qualification_effect    = none
launch_status           = blocked_missing_q029_generator_and_authorization
normalization_scope     = implemented_source_only_not_physical_hall_bell_map
alpha_h_parameter       = particles/couple_j_to_efield_coeff
alpha_h_fiducial        = 0.5
chi_h_definition        = alpha_h*j_cr0/(u_a0*b_g0)
chi_h_fiducial          = 0.5
chi_h_candidate_grid    = 0.0,0.25,0.5,1.0
signed_source_oracle_grid = -1.0,0.0,1.0
rho0                    = 1.0
b_g0                    = 1.0
u_a0                    = 1.0
j_cr0                   = 1.0
c_e0                    = 1.0
literature_map          = open_external_review_bai2015_mapping
linear_bell             = open_not_claimed
nonlinear_bell          = open_not_claimed
shock_front             = open_not_claimed
gpu                     = open_not_claimed
mpi                     = open_not_claimed
