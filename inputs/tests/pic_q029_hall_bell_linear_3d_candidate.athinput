# Q-029 SOURCE-LOCAL RUNNABLE LAUNCH PREPARATION ONLY: not an authorized deck.
# The Q-023 diagonal seed carrier is reused under a separate extended-MHD-PIC
# Hall-current identity. The positive chi_H grid is not a qualification claim.

<comment>
problem   = Q029-HALL-BELL-LINEAR 3D source-local launch candidate

<job>
basename  = pic_q029_hall_bell_linear_3d_candidate

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 4.58257569495584
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 64
x2min     = 0.0
x2max     = 2.29128784747792
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 32
x3min     = 0.0
x3max     = 1.14564392373896
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.1
nlim       = 0
tlim       = 0.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<particles>
particle_type                     = cosmic_ray
ppc                               = 2.0
pusher                            = boris_tsc
nspecies                          = 1
cr_distribution                   = center
deposit_moments                   = true
deposit_order                     = 1
deposit_qscale                    = 1.0e9
couple_moments_to_mhd             = true
couple_j_to_efield_coeff          = 1.591549430918954e-5
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode          = cc_convert
couple_moments_momentum_to_mhd    = true
couple_moments_energy_to_mhd      = true
couple_fluid_feedback_order       = mhd_src_terms
couple_moments_momentum_coeff     = 1.0
couple_moments_energy_coeff       = 1.0
cr_vx0                            = 0.545544725589981
cr_vy0                            = 1.09108945117996
cr_vz0                            = 2.18217890235992
pic_physical_mode                 = extended_mhd_pic
pic_background_mode               = coupled
pic_feedback_mode                 = coupled
pic_interp_scheme                 = tsc
pic_enable_2d3v                   = true
pic_cr_light_speed                = 2500.0
pic_cr_initial_state              = velocity
pic_cr_hall_mode                  = current_to_ct_experimental
pic_wave_damping_mode             = off
pic_max_cell_cross                = 1
pic_theta_max                     = 0.3
pic_deltaf_mode                   = off
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval                 = 0
pic_intermediate_arrays           = auto
pic_expanding_box_mode            = off

<species0>
mass   = 1.0
charge = 6.283185307179586e-6

<problem>
pgen_name = q029_hall_bell_linear

<q029_hall_bell_linear>
campaign_id          = Q029-HALL-BELL-LINEAR
deck_role            = source_local_runnable_launch_preparation_not_authorized
dimension            = 3
epsilon_default      = 0.4
epsilon              = 0.4
epsilon_grid         = 0.1,0.2,0.4,0.6,0.8
chi_h_default        = 0.5
chi_h                = 0.5
chi_h_grid           = 0.25,0.5,1.0
alpha_h_parameter    = particles/couple_j_to_efield_coeff
chi_h_definition     = alpha_h*j_cr/(u_a*b_g)
chi_h_grid_semantics = positive_launch_preparation_only_no_hall_bell_qualification
rho                  = 1.0
pressure             = 1.0
amplitude            = 1.0e-6
b_g                  = 1.0
u_a                  = 1.0
wavelength           = 1.0
k0                   = 6.283185307179586
omega                = 6.283185307179586e-6
c_over_v_cr          = 1000.0
initial_eigenmode    = q023_section52_seed_carrier_only_not_hall_dispersion_oracle
qualification_effect = none
linear_hall_bell     = open_not_claimed
nonlinear_hall_bell  = open_not_claimed
timestep             = open_clean_candidate_timestep_freeze

<output1>
file_type   = bin
variable    = mhd_w_bcc
id          = mhd_w_bcc
dcycle      = 1
ghost_zones = false

<output2>
file_type   = rst
id          = rst
dcycle      = 1
single_file_per_rank = false
