# AthenaXXX input file for uniform-MHD expanding-box analytical checks

<comment>
problem   = PIC expanding-box uniform MHD analytical oracle

<job>
basename  = pic_mhd_expanding_box_uniform

<mesh>
nghost    = 2
nx1       = 4
x1min     = 0.0
x1max     = 4.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 4
x2min     = 0.0
x2max     = 4.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 4
x3min     = 0.0
x3max     = 4.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 4
nx2       = 4
nx3       = 4

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 4
tlim       = 1.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<particles>
particle_type           = cosmic_ray
ppc                     = 0.0
pusher                  = boris_tsc
nspecies                = 1
cr_distribution         = center
deposit_moments         = false
deposit_order           = 1
deposit_qscale          = 1.0
couple_moments_to_mhd   = false
couple_j_to_efield_coeff = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode = cc_convert
couple_moments_momentum_to_mhd = false
couple_moments_energy_to_mhd   = false
couple_fluid_feedback_order    = mhd_src_terms
couple_moments_momentum_coeff  = 1.0
couple_moments_energy_coeff    = 1.0
cr_vx0                  = 0.0
cr_vy0                  = 0.0
cr_vz0                  = 0.0
pic_background_mode     = passive_mhd
pic_feedback_mode       = test_particle
pic_interp_scheme       = tsc
pic_enable_2d3v         = false
pic_cr_light_speed      = 3.0
pic_cr_initial_state    = momentum
pic_cr_hall_mode        = off
pic_max_cell_cross      = 2
pic_theta_max           = 0.3
pic_deltaf_mode         = off
pic_deltaf_f0           =
pic_sort_interval       = 0
pic_intermediate_arrays = auto
pic_expanding_box_mode  = on
pic_expansion_law       = linear
pic_expansion_rate_x1   = 0.05
pic_expansion_rate_x2   = 0.10
pic_expansion_rate_x3   = 0.15

<species0>
mass   = 1.0
charge = 1.0

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 0.0
vflow     = 0.2
along_x1  = false
along_x2  = false
along_x3  = false

<output1>
file_type   = bin
variable    = mhd_u
id          = mhd_u
dcycle      = 1
ghost_zones = false

<output2>
file_type   = bin
variable    = mhd_w
id          = mhd_w
dcycle      = 1
ghost_zones = false

<output3>
file_type   = bin
variable    = mhd_bcc
id          = mhd_bcc
dcycle      = 1
ghost_zones = false

<output4>
file_type   = hst
dcycle      = 1
data_format = %20.12e
