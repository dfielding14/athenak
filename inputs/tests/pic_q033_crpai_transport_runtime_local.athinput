# Q-033 bounded source-local runtime diagnostic only.
# This is not physical transport calibration, Q-022 closure, Frontier evidence,
# external-review closure, or launch authorization.

<comment>
problem   = Q033 bounded source-local CRPAI transport runtime diagnostic

<job>
basename  = pic_q033_crpai_transport_runtime_local

<mesh>
nghost    = 2
nx1       = 32
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 4
x2min     = 0.0
x2max     = 0.125
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 4
nx3       = 1

<mesh_refinement>
refinement           = none
num_levels           = 1
ddens_max            = 0.0
ncycle_check         = 1
refinement_interval  = 1
max_nmb_per_rank     = 128

<time>
evolution  = dynamic
integrator = rk1
cfl_number = 0.1
nlim       = 1
tlim       = 1.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<coord>
special_rel = false
general_rel = false

<particles>
particle_type                     = cosmic_ray
ppc                               = 4.0
pusher                            = boris_tsc
nspecies                          = 1
cr_distribution                   = center
deposit_moments                   = true
deposit_order                     = 1
deposit_qscale                    = 1.0e-4
couple_moments_to_mhd             = true
couple_j_to_efield_coeff          = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode          = cc_convert
couple_moments_momentum_to_mhd    = true
couple_moments_energy_to_mhd      = true
couple_fluid_feedback_order       = mhd_src_terms
couple_moments_momentum_coeff     = 1.0
couple_moments_energy_coeff       = 1.0
cr_vx0                            = 0.0
cr_vy0                            = 0.0
cr_vz0                            = 0.0
pic_background_mode               = coupled
pic_feedback_mode                 = coupled
pic_interp_scheme                 = tsc
pic_enable_2d3v                   = true
pic_cr_light_speed                = 300.0
pic_cr_initial_state              = momentum
pic_cr_hall_mode                  = off
pic_wave_damping_mode             = ion_neutral_friction
pic_ion_neutral_collision_rate    = 1.0e-4
pic_max_cell_cross                = 1
pic_theta_max                     = 0.3
pic_deltaf_mode                   = physical
pic_deltaf_f0                     = kappa_aniso
pic_deltaf_p0                     = 1.0
pic_deltaf_kappa                  = 1.25
pic_deltaf_drift_x1               = 0.0
pic_deltaf_drift_x2               = 0.0
pic_deltaf_drift_x3               = 0.0
pic_deltaf_aniso_x1               = 1.0
pic_deltaf_aniso_x2               = 1.0
pic_deltaf_aniso_x3               = 1.0
pic_deltaf_background_rho         = 1.0e-4
pic_deltaf_background_jx          = 0.0
pic_deltaf_background_jy          = 0.0
pic_deltaf_background_jz          = 0.0
pic_deltaf_adapt_mode             = global_bikappa_moments_experimental
pic_deltaf_adapt_interval         = 100.0
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval                 = 0
pic_intermediate_arrays           = auto
pic_expanding_box_mode            = on
pic_expansion_law                 = exponential
pic_expansion_rate_x1             = 0.0
pic_expansion_rate_x2             = 1.0e-5
pic_expansion_rate_x3             = 1.0e-5
track_displacement                = true
pic_random_seed                   = 330033

<species0>
mass   = 1.0
charge = 1.0

<problem>
pgen_name = q033_crpai_transport_runtime_local

<q033_crpai_transport_runtime_local>
campaign_id            = Q033-CRPAI-TRANSPORT-RUNTIME-LOCAL
deck_role              = bounded_source_local_runtime_diagnostic_only_not_transport_calibration
qualification_effect   = none
frontier_authorization = not_bound
q022_closure           = not_claimed
physical_calibration   = not_claimed
external_review        = not_claimed
momentum_distribution  = deterministic_antipodal_bounded_prolate_lattice
momentum_seed          = 330034
momentum_p0            = 1.0
momentum_xi            = 2.0
wave_spectrum          = deterministic_seeded_three_mode_transverse_ct_carrier
wave_seed              = 330033
wave_mode_count        = 3
wave_amplitude         = 1.0e-4
guide_field            = 1.0
rho                    = 1.0
pressure               = 1.0

<output1>
file_type   = hst
dcycle      = 1
data_format = %20.12e

<output2>
file_type   = bin
variable    = mhd_bcc
id          = mhd_bcc
dcycle      = 1
ghost_zones = false

<output3>
file_type   = pvtk
variable    = prtcl_all
id          = prtcl_all
dcycle      = 1
