# Q-023 SOURCE-LOCAL NONLINEAR BELL FOUNDATION ONLY.
#
# This deck is runnable preparation, not an authorized launch or qualifying
# production input.  It reuses the exact no-Hall right-polarized Bell
# eigenmode carrier from the Section 5.2 preparation and evolves it into the
# nonlinear regime in an eight-fastest-wavelength, periodic 2D box.
#
# Physical assumptions and limits:
# - paper_mhd_pic_vl2_tsc, TSC interpolation/deposition, full MHD feedback;
# - rho0=B0=U_A=1, epsilon=U_A/v_CR=0.4, and P0=1.0;
# - j_CR=2 B0 c k0, so k0 is the seeded linear Bell scale;
# - P0=1.0 retains the Bai et al. baseline convention but does not establish
#   pressure independence for this moderate-drift nonlinear regime;
# - one deterministic right-polarized seed permits controlled growth and
#   possible harmonic transfer, but does not replace a seeded ensemble or
#   establish 3D filament/cavity morphology;
# - centered quiet particle loading suppresses shot-noise and transverse-mode
#   seeding, so this is not a broadband turbulent Bell ensemble;
# - mhd_w_bcc supports magnetic amplification, MHD fluctuation-energy
#   partition, and spatial magnetic spectra.  No particle spectrum is output.
# - the inherited low-Omega carrier approximates a fixed CR-current limit.
#   mhd_w_bcc can diagnose background-gas acceleration and amplified-field
#   Alfven speed against the configured CR stream, but cannot measure evolving
#   CR current, CR drift, or an anisotropic CR pressure tensor;
# - the Riquelme-Spitkovsky constant-current saturation mechanism is retained
#   as diagnostic context only.  No Zacharegkas anisotropic-pressure
#   saturation relation is mapped or claimed.
#
# The fixed tau=k0*U_A*t windows below are source-local preregistration choices:
# linear growth tau=[2,6], nonlinear/saturation diagnostic tau=[14,22].
# They are not Q-022 reference-derived tolerances or science acceptance gates.

<comment>
problem   = Q023-PROD-BELL-NONLINEAR source-local foundation

<job>
basename  = pic_q023_prod_bell_nonlinear_foundation

<mesh>
nghost    = 2
nx1       = 512
x1min     = 0.0
x1max     = 17.88854381999832
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 256
x2min     = 0.0
x2max     = 8.94427190999916
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 64
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.1
nlim       = 0
tlim       = 4.0
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<particles>
particle_type                     = cosmic_ray
ppc                               = 16.0
pusher                            = boris_tsc
nspecies                          = 1
cr_distribution                   = center
deposit_moments                   = true
deposit_order                     = 2
deposit_qscale                    = 1.25e8
couple_moments_to_mhd             = true
couple_j_to_efield_coeff          = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode          = cc_convert
couple_moments_momentum_to_mhd    = true
couple_moments_energy_to_mhd      = true
couple_fluid_feedback_order       = mhd_src_terms
couple_moments_momentum_coeff     = 1.0
couple_moments_energy_coeff       = 1.0
cr_vx0                            = 1.118033988749895
cr_vy0                            = 2.23606797749979
cr_vz0                            = 0.0
pic_physical_mode                 = paper_mhd_pic_vl2_tsc
pic_background_mode               = coupled
pic_feedback_mode                 = coupled
pic_interp_scheme                 = tsc
pic_enable_2d3v                   = true
pic_cr_light_speed                = 2500.0
pic_cr_initial_state              = velocity
pic_cr_hall_mode                  = off
pic_wave_damping_mode             = off
pic_max_cell_cross                = 1
pic_theta_max                     = 0.3
pic_deltaf_mode                   = off
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval                 = 0
pic_intermediate_arrays           = auto
pic_expanding_box_mode            = off

<species0>
mass   = 1.0
charge = 6.283185307179586e-6

<problem>
pgen_name = q023_paper_bell_linear

# The existing generator requires its original Section 5.2 carrier identity.
# Nonlinear campaign identity and non-authorizing scope are frozen separately
# in <q023_prod_bell_nonlinear_foundation>.
<q023_paper_bell_linear>
campaign_id       = Q023-PAPER-BELL-LINEAR
deck_role         = source_local_runnable_preparation_not_authorized
dimension         = 2
epsilon_default   = 0.4
epsilon           = 0.4
epsilon_grid      = 0.1,0.2,0.4,0.6,0.8
rho               = 1.0
pressure          = 1.0
amplitude         = 1.0e-4
b_g               = 1.0
u_a               = 1.0
wavelength        = 1.0
k0                = 6.283185307179586
omega             = 6.283185307179586e-6
c_over_v_cr       = 1000.0
initial_eigenmode = section52_right_polarized_eigenmode
timestep          = open_clean_candidate_timestep_freeze

<q023_prod_bell_nonlinear_foundation>
campaign_id                         = Q023-PROD-BELL-NONLINEAR
claim_id                            = CLAIM-PROD-BELL-NONLINEAR-NOHALL-001
deck_role                           = source_local_foundation_not_authorized
carrier                             = q023_paper_bell_linear_2d_eigenmode
carrier_wavelengths_x1              = 8
carrier_wavelengths_x2              = 8
linear_growth_window_tau            = 2.0,6.0
saturation_diagnostic_window_tau    = 14.0,22.0
nonlinear_onset_delta_b_rms_over_bg = 0.1
spectrum_scope                      = mhd_spatial_magnetic_only
constant_current_diagnostic         = riquelme_spitkovsky_2009_context_only
amplified_alfven_speed_estimator    = sqrt_volume_mean_b_squared_over_volume_mean_density
anisotropic_pressure_saturation_relation = not_mapped_not_claimed
qualification_effect                = none_no_launch_no_science_authority

<output1>
file_type   = bin
variable    = mhd_w_bcc
id          = mhd_w_bcc
dt          = 0.05
ghost_zones = false

<output2>
file_type   = rst
id          = rst
dt          = 0.5
single_file_per_rank = false
