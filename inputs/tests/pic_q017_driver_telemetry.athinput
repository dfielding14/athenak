# AthenaXXX input file for bounded Q-017 driver telemetry regression

<comment>
problem   = PIC Q-017 driver telemetry

<job>
basename  = pic_q017_driver_telemetry

<mesh>
nghost    = 2
nx1       = 8
x1min     = 0.0
x1max     = 8.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 8
x2min     = 0.0
x2max     = 8.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 8
x3min     = 0.0
x3max     = 8.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 4
nx2       = 4
nx3       = 4

<mesh_refinement>
refinement           = adaptive
num_levels           = 2
ncycle_check         = 1
refinement_interval  = 1
max_nmb_per_rank     = 64

<refinement1>
level = 1
x1min = 0.0
x1max = 4.0
x2min = 0.0
x2max = 4.0
x3min = 0.0
x3max = 4.0

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 1
tlim       = 1.0
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<particles>
particle_type      = cosmic_ray
ppc                = 0.25
pusher             = drift
nspecies           = 2
cr_distribution    = center
deposit_moments    = true
deposit_order      = 1
deposit_qscale     = 1.0
couple_moments_to_mhd = false
cr_vx0             = 0.0
cr_vy0             = 0.0
cr_vz0             = 0.0
pic_background_mode = coupled
pic_feedback_mode   = coupled
pic_interp_scheme   = tsc
pic_cr_light_speed  = 1.0
pic_max_cell_cross  = 1
pic_theta_max       = 0.3
pic_deltaf_mode     = off
pic_deltaf_f0       =
pic_sort_interval   = 0
pic_random_seed     = 0
pic_q017_sync_kernel_timers = true
pic_intermediate_arrays = auto
pic_expanding_box_mode  = off
pic_expansion_rate_x1   = 0.0
pic_expansion_rate_x2   = 0.0
pic_expansion_rate_x3   = 0.0

<species0>
mass   = 1.0
charge = 1.0

<species1>
mass   = 2.0
charge = 1.0

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-6
vflow     = 0.0
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type   = bin
variable    = prtcl_d
id          = prtcl_d
dcycle      = 1
ghost_zones = false
