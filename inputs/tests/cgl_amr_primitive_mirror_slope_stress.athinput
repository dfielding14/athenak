# Pure-CGL AMR primitive-prolongation stress that trips mirror projection and slope scaling.

<job>
basename = cgl_amr_primitive_mirror_slope_stress

<mesh>
nghost = 2
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 1

<mesh_refinement>
refinement = adaptive
num_levels = 2
ncycle_check = 1
refinement_interval = 1
prolong_primitives = true
max_nmb_per_rank = 256

<amr_criterion1>
method = user

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.1
nlim = 3
tlim = 0.01
ndiag = 1

<mhd>
eos = cgl
passive = false
mirror_limiter = true
firehose_limiter = false
limiter_hardwall = true
reconstruct = plm
rsolver = hlle
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10

<problem>
pgen_name = divb_amr
user_hist = true
refine_levels = 1
refinement_mode = uniform_after_time
uniform_refine_time = 0.0
rho0 = 1.0
ppar0 = 10.0
pperp0 = 10.25
pressure_mode = sinusoidal_delta
pressure_amp = 0.5
pressure_k = 1.0
vx0 = 0.02
vy0 = 0.01
vz0 = 0.0
guide_b1 = 1.0
guide_b2 = 0.0
guide_b3 = 0.0
field_amp = 0.0
field_k = 1.0

<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
user_hist_only = false
