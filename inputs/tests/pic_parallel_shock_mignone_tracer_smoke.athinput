# Tiny 2D host regression for the Mignone shock-tracer injection path.
# It preserves the production upstream state and detector scales but is not a
# physical shock qualification run.

<comment>
problem   = pic_parallel_shock Mignone tracer injection smoke

<job>
basename  = pic_parallel_shock_mignone_tracer_smoke

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 1280.0
ix1_bc    = reflect
ox1_bc    = inflow

nx2       = 8
x2min     = 0.0
x2max     = 80.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 8
nx3       = 1

<mesh_refinement>
refinement           = none
num_levels           = 1
ncycle_check         = 1
refinement_interval  = 1
max_nmb_per_rank     = 8

<time>
evolution  = dynamic
integrator = rk1
cfl_number = 0.3
nlim       = 250
tlim       = 4.3
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.6666666666666667
nscalars    = 1

<coord>
special_rel = false
general_rel = false

<particles>
particle_type                      = cosmic_ray
ppc                                = 0.0
pusher                             = drift
pic_enable_2d3v                    = true
nspecies                           = 1
cr_distribution                    = random
deposit_moments                    = false
deposit_order                      = 1
deposit_qscale                     = 0.05
couple_moments_to_mhd              = false
couple_moments_momentum_to_mhd     = false
couple_moments_energy_to_mhd       = false
cr_vx0                             = 0.0
cr_vy0                             = 0.0
cr_vz0                             = 0.0
pic_background_mode                = coupled
pic_feedback_mode                  = test_particle
pic_max_cell_cross                 = 2
pic_sort_interval                  = 0
pic_random_seed                    = 180401946

<species0>
mass   = 1.0
charge = 1.0

<problem>
pgen_name                     = pic_parallel_shock
ps_rho0                       = 1.0
ps_p0                         = 1.0
ps_u0                         = 30.0
ps_b0                         = 1.0
ps_eta                        = 2.0e-3
ps_vinj_over_u0               = 3.1622776601683795
ps_injection_mode             = mignone_tracer
ps_mignone_swept_fraction_trigger = 0.8
ps_mignone_hot_pressure_min_factor = 30.0
ps_inject_half_width_cells    = 0.5
ps_shock_speed_model          = ideal_surface
ps_inject_t_start             = 0.0
ps_inject_t_stop              = 1.0e9
ps_remove_birth_time_before   = -1.0
ps_remove_at_time             = -1.0
ps_enable_injection           = true
ps_enable_gas_subtraction     = true
ps_subtract_stencil_cells     = 1
ps_enable_surface_averaged_subtraction = false
ps_enable_curvature_amr       = false
ps_enable_conservation_ledger = false
ps_allow_floor_clipped_subtraction = false
ps_throttle_injection_at_floor = false
ps_rho_floor_frac             = 1.0e-6
ps_p_floor_frac               = 1.0e-8
ps_inject_species             = 0
ps_inject_seed                = 180401946
ps_seed_noise_amp             = 0.0
ps_seed_noise_seed            = 180401946
ps_enable_frame_tracking      = false
ps_frame_diag_dcycle          = 1
ps_feedback_diag_dcycle       = 1

<output1>
file_type   = pvtk
variable    = prtcl_all
id          = prtcl_all
dcycle      = 20

<output2>
file_type             = rst
id                    = rst
dcycle                = 20
single_file_per_rank  = false
