# Passive-CGL AMR primitive-prolongation current-triggered smoke.

<job>
basename = cgl_amr_passive_primitive_current

<mesh>
nghost = 2
nx1 = 24
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 24
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 1

<mesh_refinement>
refinement = adaptive
num_levels = 2
ncycle_check = 1
refinement_interval = 1
prolong_primitives = true
max_nmb_per_rank = 256

<amr_criterion1>
method = user

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.1
nlim = 5
tlim = 0.02
ndiag = 1

<mhd>
eos = cgl
nscalars = 1
iso_sound_speed = 1.0
reconstruct = plm
rsolver = hlle
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10

<problem>
pgen_name = divb_amr
user_hist = true
refine_levels = 1
refinement_mode = current_threshold
current_refine_threshold = 0.25
current_derefine_fraction = 0.5
rho0 = 1.0
density_amp = 0.2
ppar0 = 10.0
pperp0 = 10.1
pressure_mode = sinusoidal_delta
pressure_amp = 0.5
pressure_k = 2.0
scalar0 = 0.4
scalar_amp = 0.2
vx0 = 0.08
vy0 = 0.05
vz0 = 0.0
guide_b1 = 0.7
guide_b2 = 0.2
guide_b3 = -0.15
field_amp = 0.05
field_k = 2.0

<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
user_hist_only = false
