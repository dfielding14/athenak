# Qualitative GEM geometry: 25.6 x 12.8, sheet width 0.5, background density 0.2, sheet density 1, perturbation flux 0.1. d_i=1 is referenced to rho=1 (upstream d_i=1/sqrt(0.2)). The small system is outside the L/d_i>=100 production regime; this is an experimental resistive-MHD benchmark, not a Hall/PIC reproduction.
# Current-limited closure: ion interpretation, fixed upstream b_rec=1.
# pressure is the upstream gas pressure; density is the upstream mass density.
<job>
basename = resistive_gem

<mesh>
nghost = 2
nx1 = 256
nx2 = 128
nx3 = 1
x1min = -12.8
x1max = 12.8
x2min = -6.4
x2max = 6.4
x3min = -0.5
x3max = 0.5
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = reflect
ox2_bc = reflect
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
sts_integrator = rkl2
sts_max_dt_ratio = 8
nlim = -1
tlim = 20
ndiag = 100

<mhd>
eos = ideal
gamma = 1.6666666666666667
reconstruct = plm
rsolver = hlld
ohmic_resistivity = 0.0001
resistivity_model = current_limited
eta_max = 5
d_i = 1
b_rec_method = constant
b_rec = 1.0
resistivity_integrator = sts

<problem>
pgen_name = resistive_tests
test = harris
user_hist = true
density = 0.2
pressure = 0.1
b0 = 1
guide_field = 0.0
width = 0.5
wave_n1 = 1
wave_n2 = 0
wave_n3 = 0
sheet_density = 1.0
perturbation = gem
perturbation_flux = 0.1
perturbation_width = 1

<output1>
file_type = bin
variable = mhd_u_bcc
id = state
data_precision = real
dt = 0.1

<output2>
file_type = bin
variable = mhd_divb
id = divb
data_precision = real
dt = 0.1

<output3>
file_type = hst
data_format = %24.16e
dt = 0.1

<output4>
file_type = bin
variable = mhd_eta
id = eta
data_precision = real
dt = 0.1

<output5>
file_type = bin
variable = mhd_q
id = q
data_precision = real
dt = 0.1
