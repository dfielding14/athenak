# 128^3 near-isothermal MHD turbulent dynamo pilot.
# Runtime deck for the 2026-07-01 follow-up run.

<comment>
problem = 128^3 driven turbulent dynamo, gas-only, gamma=1.00001

<job>
basename = pic_turbulent_dynamo_128_mhd_gamma1p00001

<mesh>
nghost = 2
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 128
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 128
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 64
nx3 = 64

<mesh_refinement>
refinement = none
num_levels = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.2
nlim = -1
tlim = 25.0
ndiag = 100

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlld
gamma = 1.00001

<eos>
iso_sound_speed = 1.0

<coord>
special_rel = false
general_rel = false

<problem>
pgen_name = turb
d_i = 1.0
d_n = 1.0
beta = 1.0
ifield = 0
user_hist = true

<initial_perturbations>
variables = magnetic
magnetic_rms = 1.0e-3
spectral_slope = 1.6666666666666667
nlow = 1
nhigh = 4
rseed = 271828
localization = none

<turb_driving>
turb_flag = 2
constant_edot = true
tcorr = 1.0
dedt = 0.15
spect_form = 1
npeak = 2
nlow = 1
nhigh = 3
driving_type = 0
sol_fraction = 1.0
dt_turb_update = 0.01
rseed = 314159

<output1>
file_type = hst
dt = 0.01

<output2>
file_type = bin
variable = mhd_w_bcc
id = mhd_w_bcc
dt = 1.0
ghost_zones = false

<output3>
file_type = rst
id = rst
dt = 5.0
single_file_per_rank = false
