# AthenaK input file for CR pusher smooth divergence-free field tests

<comment>
problem = CR pusher smooth divergence-free magnetic-field accuracy

<job>
basename = cr_pusher_smooth_divb0

<mesh>
nghost = 2
nx1 = 16
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.4
nlim = 20000
tlim = 2.0
ndiag = 20

<mhd>
eos = ideal
reconstruct = plm
rsolver = advect
gamma = 1.666666667

<particles>
particle_type = cosmic_ray
ppc = 0.0078125
nspecies = 4
pusher = boris
interpolation = tsc
min_mass = 0.25
mass_log_spacing = 2.0
cfl_part = 0.25
assign_tag = index_order
check_consistency_mode = full
check_motion_bounds = false
log_performance = true
amr_remap = device_table
validate_amr_lookup = false
amr_lookup_max_cells = 20000000
exchange_mode = alltoall_counts
update_global_counts_each_exchange = false
subcycle = true
subcycle_max_steps = 512
subcycle_cell_fraction = 0.5
subcycle_meshblock_fraction = 0.5
subcycle_gyro_fraction = 0.01
subcycle_strict = true
exchange_gyro_only_substeps = false
subcycle_per_particle_gyro = true
field_line_species = -1
field_line_speed = 1.0
field_line_direction = 1

<problem>
pgen_name = part_random
particle_position = tag_random
particle_seed = 240702
particle_velocity = isotropic_tag_random
v0 = 0.08
prtcl_rst_flag = 0
prtcl_res_file = prst/rank_00000000/cr_pusher_smooth_divb0.00000.prst
B0x = 0.1
B0y = -0.2
B0z = 1.0
B_profile = sinusoidal_divb_free
Bgrad = 1.0
Bamp = 0.015
Bwave_number = 1.0

<output1>
file_type = trk
dt = 0.1
nparticles = 8
track_per_species = true
cache_probe = false
buffer_size = 4000000
ncycle = 64
single_file_per_rank = false
single_file_per_node = false
validate_global_tags = false
trk_header_format = legacy

<output2>
file_type = prst
dt = -1.0
