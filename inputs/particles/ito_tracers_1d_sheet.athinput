# AthenaK visualization input for a 1D-style Ito-2 tracer sheet

<comment>
problem   = Ito-2 tracer sheet advected and diffused along x1

<job>
basename  = ito_tracers_1d_sheet

<mesh>
nghost    = 2
nx1       = 128
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

# The particle module requires at least two dimensions. The flow and tracer
# transport are confined to x1, so this is a 1D-style test.
nx2       = 4
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 4
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 64
tlim       = 1.0
ndiag      = 16

<hydro>
eos             = isothermal
iso_sound_speed = 1.0
reconstruct     = plm
rsolver         = llf

<particles>
particle_type   = lagrangian_ito
pusher          = ito2
ito_order       = 2
tracer_kick_pdf = uniform
ito_covariance_model = published_diagonal
random_seed     = 12345
track_variables = v1

<tracer_seed1>
id              = 1
start_time      = 0.0
end_time        = 0.0
cadence         = -1.0
count_per_event = 4096
weight          = mass
region          = slab
slab_axis       = 1
slab_min        = 0.245
slab_max        = 0.247
seed            = 24680

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 0.0
dens      = 1.0
pgas      = 1.0
vx0       = 0.6
vy0       = 0.0
vz0       = 0.0
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type = prtcl_thermo_history
dcycle    = 1
variables = v1
