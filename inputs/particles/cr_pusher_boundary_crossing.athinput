# AthenaK input file for CR pusher MeshBlock/MPI boundary-crossing stress tests

<comment>
problem = CR pusher boundary-crossing stress test

<job>
basename = cr_pusher_boundary_crossing

<mesh>
nghost = 2
nx1 = 16
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.4
nlim = 20000
tlim = 0.5
ndiag = 1

<mhd>
eos = ideal
reconstruct = plm
rsolver = advect
gamma = 1.666666667

<particles>
particle_type = cosmic_ray
ppc = 0.015625
nspecies = 2
pusher = boris
interpolation = tsc
min_mass = 1.0
mass_log_spacing = 1.0
cfl_part = 0.25
assign_tag = index_order
check_consistency_mode = full
check_motion_bounds = true
log_performance = true
amr_remap = device_table
validate_amr_lookup = false
amr_lookup_max_cells = 20000000
exchange_mode = alltoall_counts
update_global_counts_each_exchange = false
subcycle = true
subcycle_max_steps = 512
subcycle_cell_fraction = 0.25
subcycle_meshblock_fraction = 0.25
subcycle_gyro_fraction = 0.05
subcycle_strict = true
exchange_gyro_only_substeps = false
subcycle_per_particle_gyro = true

<problem>
pgen_name = part_random
particle_position = tag_random
particle_seed = 240703
particle_velocity = uniform
v0x = 0.6
v0y = 0.2
v0z = 1.0
prtcl_rst_flag = 0
prtcl_res_file = prst/rank_00000000/cr_pusher_boundary_crossing.00000.prst
B0x = 0.0
B0y = 0.0
B0z = 1.0
B_profile = uniform
Bgrad = 1.0
Bamp = 0.05
Bwave_number = 1.0

<output1>
file_type = trk
dt = 0.0625
nparticles = 16
track_per_species = true
cache_probe = false
buffer_size = 4000000
ncycle = 64
single_file_per_rank = false
single_file_per_node = false
validate_global_tags = false

<output2>
file_type = prst
dt = -1.0
