# AthenaK input for 2D two-phase ISM thermal instability traced by Ito-2 particles

<comment>
problem = 1% density perturbations about the unstable ISM equilibrium at P/k_B=3000 K cm^-3

<job>
basename = ito_tracers_thermal_instability_2d

<mesh>
nghost = 2
nx1 = 128
x1min = 0.0
x1max = 20.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 128
x2min = 0.0
x2max = 20.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 64
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 100.0
ndiag = 100

# One code length is 1 pc. Density and temperature units are chosen so that
# rho=1, pgas=1 is the unstable equilibrium n0=1.9071755 cm^-3, T0=1573.0068 K.
<units>
length_cgs = 3.0856775809623245e18
mass_cgs = 1.181666925039657e32
time_cgs = 9.615459214140742e12
mu = 1.27

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.6666666666666667
dfloor = 1.0e-4
tfloor = 6.357251738716029e-3

<problem>
pgen_name = cooling_test
density = 1.0
pressure = 1.0
vx = 0.0
vy = 0.0
vz = 0.0

# Density-only perturbations preserve the initial temperature. Since cooling is
# proportional to n^2 while heating is proportional to n, the fluctuations seed TI.
<initial_perturbations>
variables = density
density_rms = 1.0e-2
density_fractional = true
remove_density_mean = true
spectral_slope = 1.0
nlow = 1
nhigh = 8
rseed = 314159
localization = none

<cooling>
enabled = true
units = cgs
cooling_model = ism
heating_model = constant
cooling_density = number_density
heating_density = number_density
mu = 1.27
heating_rate = 1.9976230136434696e-26
timestep = true
timestep_factor = 0.1
history = true

<particles>
particle_type = lagrangian_ito
pusher = ito2
ito_order = 2
tracer_kick_pdf = uniform
ito_covariance_model = published_diagonal
random_seed = 271828
track_variables = density, pressure, temperature, v1, v2

<tracer_seed1>
id = 1
start_time = 0.0
end_time = 0.0
cadence = -1.0
count_per_event = 4096
weight = mass
region = all
seed = 161803

<output1>
file_type = hst
data_format = %16.8e
dt = 0.5

<output2>
file_type = prtcl_thermo_history
dt = 0.5
variables = density, pressure, temperature, v1, v2

<output3>
file_type = bin
variable = hydro_w
dt = 20.0
