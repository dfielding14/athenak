# AthenaK input file for second-moment Ito mass-flux tracers

<comment>
problem   = Ito-2 tracers in uniform isothermal advection

<job>
basename  = ito_tracers

<mesh>
nghost    = 2
nx1       = 32
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 8
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 8
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 1
tlim       = 1.0
ndiag      = 1

<hydro>
eos             = isothermal
iso_sound_speed = 1.0
reconstruct     = plm
rsolver         = llf

<particles>
particle_type   = lagrangian_ito
pusher          = ito2
ito_order       = 2
tracer_kick_pdf = uniform
random_seed     = 12345
next_tracer_tag = 0
ito_probability_target = 0.99
track_variables = density, pressure, temperature, v1

<tracer_seed1>
id              = 1
start_time      = 0.0
end_time        = 0.0
cadence         = -1.0
count_per_event = 4096
weight          = mass
region          = all
seed            = 24680

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 0.0
dens      = 1.0
pgas      = 1.0
vx0       = 0.5
vy0       = 0.0
vz0       = 0.0
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type = prtcl_thermo_history
dt        = 1.0
variables = density, pressure, temperature, v1

<output2>
file_type = pvtk
variable  = prtcl_all
dt        = 1.0

<output3>
file_type            = rst
dt                   = 1.0
single_file_per_rank = true
