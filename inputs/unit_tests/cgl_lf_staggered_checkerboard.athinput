# Divergence-free staggered B whose x/y components vanish in cell averages.
<job>
basename = cgl_lf_checkerboard
<mesh>
nghost = 2
nx1 = 8
nx2 = 8
nx3 = 1
x1min = 0
x1max = 1
x2min = 0
x2max = 1
x3min = 0
x3max = 1
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 8
nx2 = 8
nx3 = 1
<time>
evolution = kinematic
integrator = rk2
sts_integrator = rkl2
sts_max_dt_ratio = 20
sts_safety = 0.9
cfl_number = 0.4
nlim = 3
tlim = 1
ndiag = 1
<mhd>
eos = cgl
passive = false
cgl_heat_flux = landau_fluid
cgl_heat_flux_integrator = sts
cgl_lf_strict_admissibility = false
cgl_lf_arithmetic = safe
lf_k_parallel = 6.283185307179586
lf_coefficient_mode = background
lf_c_parallel0 = 1
nu_coll = 0
mirror_limiter = false
firehose_limiter = false
backup_limiters = false
reconstruct = plm
rsolver = advect
gamma = 1.666666666666667
dfloor = 1e-12
pfloor = 1e-12
tfloor = 1e-12
sfloor = 1e-12
bfloor = 1e-10
<problem>
pgen_name = cgl_landau_fluid
test_mode = staggered_checkerboard
rho0 = 1
ppar0 = 1
pperp0 = 1
b0 = 1
bz0 = 0.1
amp = 1e-6
<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
