# T-B3: advect a three-cell, 1000:1 p_perp peak for 50 cycles.
<job>
basename = cgl_reconstruction_wenoz
<mesh>
nghost = 4
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 64
nx2 = 1
nx3 = 1
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 50
tlim = 100.0
ndiag = 1
<mhd>
eos = cgl
fofc = true
reconstruct = wenoz
rsolver = hlle
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10
<problem>
pgen_name = cgl_fofc
test_mode = pressure_step
user_srcs = true
<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
<output2>
file_type = log
dcycle = 1
