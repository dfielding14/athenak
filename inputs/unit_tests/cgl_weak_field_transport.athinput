# Advect B<bfloor into B=1 across a pressure-balanced transverse contact.
<job>
basename = cgl_weak_field_transport
<mesh>
nghost = 3
nx1 = 128
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 128
nx2 = 1
nx3 = 1
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 50
tlim = 100.0
ndiag = 50
<mhd>
eos = cgl
fofc = true
reconstruct = plm
rsolver = hlle
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10
<problem>
pgen_name = cgl_fofc
test_mode = weak_field_transport
weak_field_velocity = 10.0
<output1>
file_type = tab
variable = mhd_w
data_format = %24.16e
dcycle = 1
<output2>
file_type = log
dcycle = 1
