# T-A2: uniform anisotropy relaxation over 20 cycles, with optional LF via CLI.

<job>
basename = cgl_collision_once

<mesh>
nghost = 2
nx1 = 16
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 20
tlim = 10.0
ndiag = 1

<mhd>
eos = cgl
passive = false
nu_coll = 10.0
mirror_limiter = false
limiter_nu_coll = 0.0
reconstruct = plm
rsolver = hlle
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10

<problem>
pgen_name = cgl_landau_fluid
test_mode = collision_relaxation
limiter_kind = mirror
amp = 0.0
rho0 = 1.0
ppar0 = 1.0
pperp0 = 1.2
b0 = 1.0
collision_rel_tol = 1.0e-10
validation_output = false
validation_output_dir = docs/figures/data

<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
