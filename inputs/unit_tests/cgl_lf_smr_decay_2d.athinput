# Two-level static mesh LF decay across coarse-fine interfaces, with total-E conservation.

<job>
basename = cgl_lf_smr_decay_2d

<mesh>
nghost = 2
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 1

<mesh_refinement>
refinement = static
prolong_primitives = false
max_nmb_per_rank = 64

<refined_region1>
level = 1
x1min = 0.25
x1max = 0.75
x2min = 0.0
x2max = 1.0
x3min = 0.0
x3max = 1.0

<time>
evolution = kinematic
integrator = rk2
sts_integrator = rkl2
sts_max_dt_ratio = 20.0
cfl_number = 0.4
nlim = -1
tlim = 0.1329807601338109
ndiag = 100

<mhd>
eos = cgl
passive = false
cgl_heat_flux = landau_fluid
cgl_heat_flux_integrator = sts
lf_k_parallel = 6.283185307179586
lf_coefficient_mode = background
lf_c_parallel0 = 1.0
cgl_lf_strict_admissibility = true
cgl_lf_profile = true
reconstruct = plm
rsolver = advect
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
sfloor = 1.0e-12
bfloor = 1.0e-10
nu_coll = 0
mirror_limiter = false
firehose_limiter = false
backup_limiters = false

<problem>
pgen_name = cgl_landau_fluid
test_mode = rotated_decay
rotated_axis = x
mode_number = 1
rho0 = 1.0
ppar0 = 1.0
pperp0 = 1.0
b0 = 0.8660254037844386
by0 = 0.5
bz0 = 0.0
amp = 1.0e-4
decay_rel_tol = 1.0e-2
phase_rel_tol = 1.0e-3
validation_output = true
validation_output_dir = .

<output1>
file_type = hst
data_format = %24.16e
dcycle = 1

<output2>
file_type = tab
id = xslice
variable = mhd_w
data_format = %24.16e
slice_x2 = 0.1
slice_x3 = 0.0
dt = 1

<output3>
file_type = tab
id = yslice
variable = mhd_w
data_format = %24.16e
slice_x1 = 0.1
slice_x3 = 0.0
dt = 1
