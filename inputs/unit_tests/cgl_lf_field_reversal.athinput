# Frozen LF current sheet, with the historical one-cell width and alternating seed.
<job>
basename = cgl_lf_field_reversal
<mesh>
nghost = 2
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 64
nx2 = 1
nx3 = 1
<time>
evolution = kinematic
integrator = rk2
sts_integrator = none
sts_max_dt_ratio = 20.0
cfl_number = 0.1
nlim = 20
tlim = 1.0
ndiag = 1
<mhd>
eos = cgl
passive = false
cgl_heat_flux = landau_fluid
cgl_heat_flux_integrator = explicit
lf_k_parallel = 6.283185307179586
lf_coefficient_mode = background
lf_c_parallel0 = 1.0
cgl_lf_strict_admissibility = true
cgl_lf_arithmetic = safe
cgl_lf_diagnostics = full
reconstruct = plm
rsolver = advect
gamma = 1.666666666666667
dfloor = 1.0e-12
pfloor = 1.0e-12
tfloor = 1.0e-12
bfloor = 1.0e-10
nu_coll = 0.0
mirror_limiter = false
firehose_limiter = false
backup_limiters = false
<problem>
pgen_name = cgl_landau_fluid
test_mode = field_reversal
user_srcs = true
b0 = 0.03
rho0 = 1.0
ppar0 = 1.0
pperp0 = 1.0
amp = 1.0e-8
reversal_width = 0.0
<output1>
file_type = hst
data_format = %24.16e
dcycle = 1
