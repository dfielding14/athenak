# Q-011 PREPARATION DECK ONLY: not launch authorization or reproduction evidence.
# Freeze Sun & Bai (2023) Section 5.4 sourced values separately from the open
# AthenaK load-balance tuning and campaign audits.

<comment>
problem   = Q-011 Section 5.4 parallel-shock paper preparation deck

<job>
basename  = pic_parallel_shock_section54_paper_vl2_tsc

<mesh>
nghost    = 2
# Root-level cell size is 12 c/omega_pi; two refinement levels reach 3.
nx1       = 4000
x1min     = 0.0
x1max     = 48000.0
ix1_bc    = reflect
ox1_bc    = inflow

nx2       = 260
x2min     = 0.0
x2max     = 3120.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
# Figure 8 uses 20 x 20 cells per MeshBlock.
nx1       = 20
nx2       = 20
nx3       = 1

<mesh_refinement>
refinement           = adaptive
num_levels           = 3
ddens_max            = 0.0
dpres_max            = 0.0
dvel_max             = 0.0
ncycle_check         = 1
refinement_interval  = 1
max_nmb_per_rank     = 8192

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
tlim       = 1200.0
nlim       = 200000
ndiag      = 50

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<coord>
special_rel = false
general_rel = false

<particles>
particle_type                     = cosmic_ray
ppc                               = 0.0
pusher                            = boris_tsc
pic_enable_2d3v                   = true
nspecies                          = 1
cr_distribution                   = random
deposit_moments                   = true
deposit_order                     = 2
# AthenaK normalized macro-mass choice. With eta=1e-3, rho0=1,
# u_sh'=10, swept speed=40, IPWT=1, and collapsed x3 thickness=1, this gives
# downstream 640/160/40 ppc on the 12/6/3 c/omega_pi AMR ladder.
deposit_qscale                    = 9.0e-4
couple_moments_to_mhd             = true
couple_j_to_efield_coeff          = 1.0
couple_j_to_efield_representation = cell_centered
couple_j_deposition_mode          = cc_convert
couple_fluid_feedback_order       = mhd_src_terms
couple_moments_momentum_to_mhd    = true
couple_moments_energy_to_mhd      = true
couple_moments_momentum_coeff     = 1.0
couple_moments_energy_coeff       = 1.0
cr_vx0                            = 0.0
cr_vy0                            = 0.0
cr_vz0                            = 0.0
pic_physical_mode                 = paper_mhd_pic_vl2_tsc
pic_background_mode               = coupled
pic_feedback_mode                 = coupled
pic_interp_scheme                 = tsc
pic_cr_light_speed                = 10000.0
pic_cr_initial_state              = momentum
pic_cr_hall_mode                  = off
pic_wave_damping_mode             = off
pic_ion_neutral_collision_rate    = 0.0
pic_max_cell_cross                = 2
pic_theta_max                     = 0.3
pic_deltaf_mode                   = off
pic_deltaf_adapt_mode             = off
pic_deltaf_adapt_interval         = 0.0
# Preparation choice only: Frontier load-balance tuning remains open.
pic_load_balance_cost_per_particle = 0.0
pic_sort_interval                 = 16
pic_intermediate_arrays           = auto
pic_random_seed                   = 23050101
pic_expanding_box_mode            = off

<species0>
# AthenaK stores normalized q/(m*c) in IPM. pic_cr_light_speed is the
# separate artificial C used for relativistic kinematics; do not divide IPM
# by pic_cr_light_speed again.
mass   = 1.0
charge = 1.0

<problem>
pgen_name                     = pic_parallel_shock
ps_rho0                       = 1.0
# Section 5.4 does not state p0. Bai et al. (2015), the cited predecessor
# setup, uses p0=1.0. This inferred baseline gives beta0=2, cs=sqrt(5/3),
# and upstream sonic Mach number Ms=23.237900. The preregistered
# pressure-sensitivity pilots also test p0=0.05, 0.10, and 0.20.
ps_p0                         = 1.0
ps_u0                         = 30.0
ps_b0                         = 1.0
ps_eta                        = 1.0e-3
ps_vinj_over_u0               = 3.16227766017
ps_inject_half_width_cells    = 0.5
# Section 5.4 ideal surface x = ((Gamma - 1) u0 / 2) t.
ps_shock_speed_model          = ideal_surface
# Inject from t=0. Remove the startup cohort from the simulated particle state at 45.
ps_inject_t_start             = 0.0
ps_inject_t_stop              = 1.0e9
ps_remove_birth_time_before   = 45.0
ps_enable_injection           = true
ps_enable_gas_subtraction     = true
ps_enable_curvature_amr       = true
ps_refine_curv                = 1.0
ps_derefine_curv              = 0.1
ps_rho_floor_frac             = 1.0e-6
ps_p_floor_frac               = 1.0e-8
ps_inject_species             = 0
ps_inject_seed                = 23050101
ps_seed_noise_amp             = 0.0
ps_seed_noise_seed            = 23050101
ps_enable_frame_tracking      = false
ps_frame_mode                 = velocity
ps_frame_t_start              = 0.0
ps_frame_t_ramp               = 0.0
ps_frame_vfrac                = 1.0
ps_frame_dv_max               = 1.0e99
ps_frame_apply_to_particles   = true
ps_frame_apply_to_inflow      = true
ps_frame_require_uniform      = true
ps_frame_diag_dcycle          = 2000
ps_feedback_diag_dcycle       = 2000
ps_recenter_x_target          = 24000.0
ps_recenter_x_trigger         = 36000.0
ps_recenter_shift_cells       = 2
ps_recenter_vshock_model      = -1.0

<output1>
file_type   = bin
variable    = mhd_w_d
id          = rho
dt          = 100.0
ghost_zones = false

<output2>
file_type   = bin
variable    = mhd_bmag
id          = bmag
dt          = 100.0
ghost_zones = false

<output3>
file_type   = bin
variable    = prtcl_jx
id          = prtcl_jx
dt          = 100.0
ghost_zones = false

<output4>
file_type   = bin
variable    = mhd_j2
id          = j2
dt          = 100.0
ghost_zones = false

<output5>
file_type   = pvtk
variable    = prtcl_all
id          = prtcl_all
dt          = 100.0

<output6>
file_type   = rst
dt          = 100.0
