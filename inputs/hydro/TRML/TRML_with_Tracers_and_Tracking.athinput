# Canonical clean simple-TRML run with perturbations and thermodynamic
# Monte-Carlo tracers. Frame tracking is present as an optional disabled block.
# t_shear = (x1max - x1min)/velocity = 1.5491933384829668.
# Validated locally on 8 MPI ranks at 48 x 48 x 96. No timed retuning is used.

<comment>
problem = Simple cooling TRML with interface tracking and thermodynamic tracers

<job>
basename = TRML_with_Tracers_and_Tracking

<mesh>
nghost = 4

# The 2 x 2 x 2 MeshBlock layout below gives one block per rank with 8 MPI ranks.
nx1 = 48
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic

nx2 = 48
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 96
x3min = -1.0
x3max = 1.0
# Both x3 faces use pgen user reservoirs. The lower boundary is a fixed cold
# reservoir wall with reflected normal velocity, preventing moving-frame drainage
# of dense cold gas; the upper boundary remains the hot inflow reservoir.
ix3_bc = user
ox3_bc = user

<meshblock>
nx1 = 24
nx2 = 24
nx3 = 48

# Disabled by default. The committed local/Frontier matrix enables this block to exercise
# simultaneous particle remapping and frame-tracker MeshBlockPack updates.
<mesh_refinement>
refinement = none
num_levels = 2
refinement_interval = 1
max_nmb_per_rank = 256

<amr_criterion0>
method = min_max
variable = hydro_w_s00
value_max = 0.1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
# 50 shear times.
tlim = 77.45966692414834
ndiag = 2000

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666667
nscalars = 1
fofc = true
dfloor = 1.0e-4
pfloor = 1.0e-5

<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 0.6

<problem>
rho_hot = 1.0
# chi = rho_cold/rho_hot = 10^1.75.
rho_cold = 56.23413251903491
# Relative shear Mach number is 0.5 for the pressure and gamma below.
velocity = 0.6454972243679028
# The cleaned simple_TRML pgen uses the original smooth tanh density/shear
# interface. There is no physical initial z velocity in the original lab frame.
initial_profile = tanh
fixed_frame_velocity_x3 = 0.0
# Hold the imposed shear vx in the upper reservoir. Set true to copy vx from the
# upper boundary-adjacent active cell instead.
zero_gradient_vx = false
# Lower user-x3 boundary mode. Options:
#   reflect: fixed cold reservoir wall with reflected normal velocity.
#   outflow: copy the adjacent active conserved state into the lower ghost zones.
#   mass_balance: fixed-density cold reservoir with explicit vz, or with live
#                 top-Mdot balancing when a frame tracker has a valid average.
lower_x3_user_bc = reflect
# For lower_x3_user_bc=mass_balance:
#   fixed:          P=P0.
#   total_pressure: P=P0 + rho_hot*(v_hot_lab - v_cold_lab)^2, using the
#                   top-Mdot average and mass-balanced lower velocity.
lower_x3_mass_balance_pressure_mode = fixed
# For lower_x3_user_bc=mass_balance:
#   zero_gradient: copy vx,vy from the lower active layer, but at rho_cold.
#   reservoir:     use fixed cold-stream lab velocities transformed to the frame.
lower_x3_mass_balance_tangential_mode = zero_gradient
# Used by lower_x3_user_bc=mass_balance before any live top-Mdot average is
# available. Interpreted in lower_x3_mass_balance_velocity_frame.
lower_x3_mass_balance_vz = 0.0
lower_x3_mass_balance_velocity_frame = grid
# Negative disables the cap.
lower_x3_mass_balance_max_abs_vz = -1.0
pres = 1.0
# Minimum cooling time chosen for xi = 100.
t_cool_min = 0.015491933384829668
T_cutoff_over_T_cold = 20.0
T_ci_over_T_cold = 10.0
T_ih_over_T_cold = 30.0
beta = 0.0
# Negative disables the optional smooth startup ramp. Set to one shear time
# for the outflow comparison matrix.
cooling_ramp_time = -1.0
cooling_ramp_min_factor = 0.0

user_srcs = true
user_dt = true
user_hist = true
user_bcs = true

phase_sharpness = 96

# Retained for compatibility with simple_TRML. The shared perturbation module below
# supplies the actual initial velocity perturbation, so this amplitude must remain zero.
max_init_perturb_log2freq = 5
min_init_perturb_log2freq = 2
init_perturb_sharpness = 50.0
init_perturb_vel_frac = 0.0

<initial_perturbations>
# Reproducible, solenoidal in-plane perturbations localized around the interface.
variables = velocity
velocity_rms = 0.02
remove_velocity_mean = true
spectral_slope = 1.666666666666667
nlow = 2
nhigh = 4
min_kz = 0
max_kz = 0
f_solenoidal = 1.0
rseed = 24680
localization = include
x3_center = 0.0
x3_scale = 0.1414213562373095

<frame_tracking>
# Optional finite-window top-Mdot frame tracking. Leave disabled for the clean
# baseline. Sign convention:
#   Mdot_top = integral rho*v3*dA at upper x3, positive outward/+x3.
#   v_grid = v_lab - V_frame.
enabled = false
tracked_fluid = hydro
start_time = 0.0
apply_every = 1
diagnostic_every = 2000
axes = x3
mode = top_mdot_window
mdot_velocity_sign = flipped
mdot_velocity_factor = 1.0
mdot_density_mode = geometric_mean
mdot_area = -1.0
mdot_start_time = 0.5
mdot_window_time = 1.5491933384829668
max_abs_boost = 0.2
max_boost_change_mode = per_time
max_boost_change_rate = 0.02

<particles>
# Thermodynamic fields are sampled at each MC tracer's grid-frame cell center.
particle_type = lagrangian_mc
pusher = lagrangian_mc
random_seed = 67890
track_variables = density, pressure, temperature, entropy, v1, v2, v3, mach, scalar0

<tracer_seed1>
# 777 tracers (25.3% of the population) uniformly sample the initial volume at t=0.
id = 1
start_time = 0.0
end_time = 0.0
cadence = -1.0
count_per_event = 777
weight = volume
region = all
seed = 112233

<tracer_seed2>
# Inject 45 tracers at each of 51 uniformly spaced times from t=0
# through t=50*t_shear.
# This contributes 2,295 tracers (74.7%), for 3,072 total.
id = 2
start_time = 0.0
end_time = 77.45966692414834
cadence = 1.5491933384829668
count_per_event = 45
weight = volume
region = slab
slab_axis = 3
# Top active-cell layer: one root-grid cell thick for nx3=96.
slab_min = 0.9791666666666666
slab_max = 1.0
seed = 223344

<output1>
# Hydro, user-cooling, and frame-tracker histories share this cadence.
file_type = hst
data_format = %24.16e
dt = 0.25

<output2>
file_type = prtcl_thermo_history
id = thermo
dt = 0.25
variables = density, pressure, temperature, entropy, v1, v2, v3, mach, scalar0

<output3>
# Single-precision full-volume primitive snapshots for restart-independent checks.
file_type = bin
id = state
variable = hydro_w
ghost_zones = false
dt = 15.0

<output4>
# Single-precision primitive slice through x1=0, sampled every quarter shear time.
file_type = bin
id = slice_x1
variable = hydro_w
slice_x1 = 0.0
ghost_zones = false
dt = 0.3872983346207417

<output5>
# Single-precision primitive slice through x2=0, sampled every quarter shear time.
file_type = bin
id = slice_x2
variable = hydro_w
slice_x2 = 0.0
ghost_zones = false
dt = 0.3872983346207417

<output6>
# Single-precision primitive slice through x3=0, sampled every quarter shear time.
file_type = bin
id = slice_x3
variable = hydro_w
slice_x3 = 0.0
ghost_zones = false
dt = 0.3872983346207417

<output7>
# Effectively disable frequent particle VTK dumps; thermo histories remain enabled above.
file_type = pvtk
id = tracers
variable = prtcl_all
dt = 1.0e9

<output8>
# Per-rank restart files preserve frame state, tracers, and injection schedules under MPI.
file_type = rst
dt = 25.0
single_file_per_rank = true
