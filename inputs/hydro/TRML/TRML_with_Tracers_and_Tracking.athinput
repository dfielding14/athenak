# AthenaK input for the integrated simple TRML, interface frame tracker,
# one-time Fourier perturbations, and Monte-Carlo thermodynamic tracers.

<comment>
problem = Simple cooling TRML with interface tracking and thermodynamic tracers

<job>
basename = TRML_with_Tracers_and_Tracking

<mesh>
nghost = 4

nx1 = 64
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic

nx2 = 64
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 128
x3min = -1.0
x3max = 1.0
ix3_bc = user
ox3_bc = user

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 64

# Disabled by default. The committed local/Frontier matrix enables this block to exercise
# simultaneous particle remapping and frame-tracker MeshBlockPack updates.
<mesh_refinement>
refinement = none
num_levels = 2
refinement_interval = 1
max_nmb_per_rank = 256

<amr_criterion0>
method = min_max
variable = hydro_w_s00
value_max = 0.1

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.3
nlim = -1
tlim = 20.0
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.666666667
nscalars = 1
fofc = true
dfloor = 1.0e-4
pfloor = 1.0e-5

<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 0.6

<problem>
rho_hot = 1.0
rho_cold = 56.23413251
velocity = 1.0
zero_gradient_vx = true
pres = 1.0
t_cool_min = 0.05
T_cutoff_over_T_cold = 20.0
T_ci_over_T_cold = 10.0
T_ih_over_T_cold = 30.0
beta = 0.0

user_srcs = true
user_dt = true
user_hist = true
user_bcs = true

phase_sharpness = 100.0

# Retained for compatibility with simple_TRML. The shared perturbation module below
# supplies the actual initial velocity perturbation, so this amplitude must remain zero.
max_init_perturb_log2freq = 5
min_init_perturb_log2freq = 2
init_perturb_sharpness = 50.0
init_perturb_vel_frac = 0.0

<initial_perturbations>
variables = velocity
velocity_rms = 0.02
remove_velocity_mean = true
spectral_slope = 1.666666666666667
nlow = 4
nhigh = 16
min_kz = 0
max_kz = 0
f_solenoidal = 1.0
rseed = 24680
localization = include
x3_center = 0.0
x3_scale = 0.1414213562373095

<frame_tracking>
enabled = true
tracked_fluid = hydro
start_time = 0.0
apply_every = 1
diagnostic_every = 5
axes = x3
x3_target = 0.0
target = scalar0
target_min = 0.05
target_max = 0.2
weight = volume
mode = pd
position_signal = centroid
velocity_signal = position_rate
tau_avg = 0.1
tau_relax = 0.1
tau_vel = 0.05
max_abs_boost = 0.2
max_boost_change_mode = per_time
max_boost_change_rate = 1.0

<particles>
particle_type = lagrangian_mc
pusher = lagrangian_mc
random_seed = 67890
track_variables = density, pressure, temperature, entropy, v1, v2, v3, mach, scalar0

<tracer_seed1>
id = 1
start_time = 0.0
end_time = 0.0
cadence = -1.0
count_per_event = 777
weight = volume
region = all
seed = 112233

<tracer_seed2>
id = 2
start_time = 0.0
end_time = 20.0
cadence = 0.4
count_per_event = 45
weight = volume
region = slab
slab_axis = 3
# A top-boundary slab one cell thick on the committed 128-cell x3 root grid.
slab_min = 0.984375
slab_max = 1.0
seed = 223344

<output1>
file_type = hst
data_format = %24.16e
dt = 0.01

<output2>
file_type = prtcl_thermo_history
id = thermo
dt = 0.01
variables = density, pressure, temperature, entropy, v1, v2, v3, mach, scalar0

<output3>
file_type = bin
id = state
variable = hydro_w
data_precision = real
ghost_zones = false
dt = 0.1

<output4>
file_type = pvtk
id = tracers
variable = prtcl_all
dt = 0.1

<output5>
file_type = rst
dt = 1.0
single_file_per_rank = true
