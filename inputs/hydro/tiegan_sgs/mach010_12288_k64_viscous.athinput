# Tiegan SGS explicit-viscosity convergence run: fully 2D isothermal turbulence.
# Run with a machine-appropriate MPI/GPU launcher and record the exact Git commit.
#
# Physical parameters shared with the 16384^2 production candidate:
#   c_s = 1, target v_rms = 0.1, target Mach = 0.1
#   sparse global annulus 63 <= |k| <= 65, npeak = 64, 64 complex modes
#   L_drive = L_box/64 = 0.015625, t_eddy = L_drive/v_rms = 0.15625
#   drag_rate = 0.1, dedt = 0.001, viscosity nu = 1.316e-7
#   estimated eta = (2*pi*k_f)^2*dedt = 161.704
#   inverse-wavenumber length l_nu = (nu^3/eta)^(1/6) = 1.5542e-4
#   dissipation mode n_nu = 1/(2*pi*l_nu) = 1024.0 = 16.0*k_f
#   cutoff wavelength lambda_nu = 1/n_nu = 9.7654e-4 = 12.0 cells
#
# This is the lower-resolution member of a same-physics convergence pair. Its
# cutoff wavelength is acceptably sampled but less conservatively than the 16-cell
# sampling in mach010_16384_k64_viscous.athinput.
#
# The run lasts 40 forcing-scale turnover times. SGS output is written 20 times
# per turnover; full-resolution output is written once per turnover.

<comment>
problem = Tiegan SGS Mach-0.1 12288^2 explicit-viscosity convergence run

<job>
basename = tiegan_sgs_m010_12288_k64_visc_nu1p316e7

<mesh>
nghost = 3
nx1 = 12288
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 12288
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 512
nx2 = 512
nx3 = 1

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.4
nlim = -1
tlim = 6.25
ndiag = 100

<hydro>
eos = isothermal
reconstruct = wenoz
rsolver = roe
iso_sound_speed = 1.0
viscosity = 1.316e-7

<hydro_srcterms>
linear_drag = true
drag_rate = 0.1

<problem>
d_n = 1.0

<turb_driving>
turb_flag = 2
tcorr = 0.15625
dt_update = 0.0015625
normalization = edot
dedt = 0.001
nlow = 63
nhigh = 65
npeak = 64
spectrum = parabolic
mode_sampling = sparse_annulus
sparse_mode_count = 64
min_kz = 0
max_kz = 0
sol_fraction = 1.0
rseed = 2718

<output1>
file_type = hst
dt = 0.0078125

<output2>
file_type = rst
dt = 0.625

<output3>
file_type = bin
variable = hydro_w
id = prim
dt = 0.15625

<output4>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f004
coarsen_factor = 4
dt = 0.0078125

<output5>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f008
coarsen_factor = 8
dt = 0.0078125

<output6>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f016
coarsen_factor = 16
dt = 0.0078125

<output7>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f032
coarsen_factor = 32
dt = 0.0078125

<output8>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f064
coarsen_factor = 64
dt = 0.0078125

<output9>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f128
coarsen_factor = 128
dt = 0.0078125

<output10>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f256
coarsen_factor = 256
dt = 0.0078125

<output11>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f512
coarsen_factor = 512
dt = 0.0078125
