# Tiegan SGS commissioning run: fully 2D, isothermal, solenoidally driven turbulence.
# Build with: cmake -S . -B build-tiegan-sgs -DPROBLEM=turb
#             cmake --build build-tiegan-sgs -j
#
# Nominal scales:
#   c_s = 1, target v_rms = 0.25, target Mach = 0.25
#   L_box = 1, sparse global annulus 31 <= |k| <= 33, npeak = 32
#   L_drive = L_box/32 = 0.03125
#   t_eddy = L_drive/v_rms = 0.125
#   tlim = 10 t_eddy = 1.25
#   output cadence = t_eddy/20 = 0.00625
#   drag_rate = v_rms/L_box = 0.25, dedt = drag_rate*v_rms^2 = 0.015625
#
# Sparse annulus sampling evolves 32 global modes without enumerating the mode volume.
# Uniform Rayleigh drag arrests the inverse cascade near the box scale. The achieved
# Mach number must still be measured because this balance is not a thermostat.

<comment>
problem = Tiegan SGS Mach-0.25 commissioning run

<job>
basename = tiegan_sgs_m025_1024

<mesh>
nghost = 3
nx1 = 1024
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1024
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 512
nx2 = 512
nx3 = 1

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.4
nlim = -1
tlim = 1.25
ndiag = 100

<hydro>
eos = isothermal
reconstruct = wenoz
rsolver = roe
iso_sound_speed = 1.0

<hydro_srcterms>
linear_drag = true
drag_rate = 0.25

<problem>
d_n = 1.0

<turb_driving>
turb_flag = 2
tcorr = 0.125
dt_update = 0.00125
normalization = edot
dedt = 0.015625
nlow = 31
nhigh = 33
npeak = 32
spectrum = parabolic
mode_sampling = sparse_annulus
sparse_mode_count = 32
min_kz = 0
max_kz = 0
sol_fraction = 1.0
rseed = 2718

<output1>
file_type = hst
dt = 0.00625

<output2>
file_type = rst
dt = 0.125

<output3>
file_type = bin
variable = hydro_w
id = prim
dt = 0.00625

<output4>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f004
coarsen_factor = 4
dt = 0.00625

<output5>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f008
coarsen_factor = 8
dt = 0.00625

<output6>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f016
coarsen_factor = 16
dt = 0.00625

<output7>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f032
coarsen_factor = 32
dt = 0.00625

<output8>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f064
coarsen_factor = 64
dt = 0.00625

<output9>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f128
coarsen_factor = 128
dt = 0.00625
