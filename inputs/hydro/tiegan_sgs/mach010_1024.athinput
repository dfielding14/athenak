# Tiegan SGS fiducial run: fully 2D, isothermal, solenoidally driven turbulence.
# Build with: cmake -S . -B build-tiegan-sgs -DPROBLEM=turb
#             cmake --build build-tiegan-sgs -j
#
# Nominal scales:
#   c_s = 1, target v_rms = 0.1, target Mach = 0.1
#   L_box = 1, npeak = 2, L_drive = L_box/npeak = 0.5
#   t_eddy = L_drive/v_rms = 5
#   tlim = 10 t_eddy = 50
#   cbin cadence = t_eddy/20 = 0.25
#   dedt = v_rms^3/L_drive = 0.002
#
# Constant-Edot driving is the initial choice because it directly fixes the injection
# rate associated with the target velocity scale. The achieved Mach number must still
# be measured: 2D turbulence has an inverse cascade and no large-scale drag is included.

<comment>
problem = Tiegan SGS fiducial Mach-0.1 run

<job>
basename = tiegan_sgs_m010_1024

<mesh>
nghost = 3
nx1 = 1024
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1024
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 512
nx2 = 512
nx3 = 1

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.4
nlim = -1
tlim = 50.0
ndiag = 100

<hydro>
eos = isothermal
reconstruct = wenoz
rsolver = roe
iso_sound_speed = 1.0

<problem>
d_n = 1.0

<turb_driving>
turb_flag = 2
tcorr = 5.0
dt_update = 0.05
normalization = edot
dedt = 0.002
nlow = 1
nhigh = 3
npeak = 2
spectrum = parabolic
min_kz = 0
max_kz = 0
sol_fraction = 1.0
rseed = 2718

<output1>
file_type = hst
dt = 0.25

<output2>
file_type = rst
dt = 5.0

<output4>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f004
coarsen_factor = 4
dt = 0.25

<output5>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f008
coarsen_factor = 8
dt = 0.25

<output6>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f016
coarsen_factor = 16
dt = 0.25

<output7>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f032
coarsen_factor = 32
dt = 0.25

<output8>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f064
coarsen_factor = 64
dt = 0.25

<output9>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f128
coarsen_factor = 128
dt = 0.25
