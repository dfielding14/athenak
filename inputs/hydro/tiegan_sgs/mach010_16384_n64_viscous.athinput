# Tiegan SGS explicit-viscosity production candidate: fully 2D isothermal turbulence.
# Run only after the 12288^2 convergence case and a short machine-specific scaling pilot.
#
# Nominal physical and resolution scales:
#   c_s = 1, target v_rms = 0.1, target Mach = 0.1
#   sparse global annulus 63 <= |n| <= 65, npeak = 64, 64 complex modes
#   L_drive = L_box/npeak = 0.015625, t_eddy = L_drive/v_rms = 0.15625
#   drag_rate = 0.1, dedt = 0.001, viscosity nu = 1.316e-7
#   estimated eta = (2*pi*npeak)^2*dedt = 161.704
#   inverse angular-wavenumber length 1/k_visc = 1.5542e-4
#   AthenaK mode n_visc = k_visc/(2*pi) = 1024.0 = 16.0*npeak
#   viscous wavelength lambda_visc = 1/n_visc = 9.7654e-4 = 16.0 cells
#   forcing-scale Reynolds number v_rms*L_drive/nu = 11873
#
# The coefficient targets n_visc/npeak = 16 and a 16-cell viscous wavelength. The
# inverse angular-wavenumber length 1/k_visc is 2.55 cells because k=2*pi*n/L.
# A measured enstrophy budget and 12288^2/16384^2 convergence comparison are still
# required before labeling the resulting dataset resolved DNS.
#
# The run lasts 40 forcing-scale turnover times. SGS output is written 20 times
# per turnover; full-resolution output is written once per turnover.

<comment>
problem = Tiegan SGS Mach-0.1 16384^2 resolved-viscosity production candidate

<job>
basename = tiegan_sgs_m010_16384_n64_visc_nu1p316e7

<mesh>
nghost = 3
nx1 = 16384
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16384
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 512
nx2 = 512
nx3 = 1

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.4
nlim = -1
tlim = 6.25
ndiag = 100

<hydro>
eos = isothermal
reconstruct = wenoz
rsolver = roe
iso_sound_speed = 1.0
viscosity = 1.316e-7

<hydro_srcterms>
linear_drag = true
drag_rate = 0.1

<problem>
d_n = 1.0

<turb_driving>
turb_flag = 2
tcorr = 0.15625
dt_update = 0.0015625
normalization = edot
dedt = 0.001
nlow = 63
nhigh = 65
npeak = 64
spectrum = parabolic
mode_sampling = sparse_annulus
sparse_mode_count = 64
min_kz = 0
max_kz = 0
sol_fraction = 1.0
rseed = 2718

<output1>
file_type = hst
dt = 0.0078125

<output2>
file_type = rst
dt = 0.625

<output3>
file_type = bin
variable = hydro_w
id = prim
dt = 0.15625

<output4>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f004
coarsen_factor = 4
dt = 0.0078125

<output5>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f008
coarsen_factor = 8
dt = 0.0078125

<output6>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f016
coarsen_factor = 16
dt = 0.0078125

<output7>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f032
coarsen_factor = 32
dt = 0.0078125

<output8>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f064
coarsen_factor = 64
dt = 0.0078125

<output9>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f128
coarsen_factor = 128
dt = 0.0078125

<output10>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f256
coarsen_factor = 256
dt = 0.0078125

<output11>
file_type = cbin
variable = hydro_sgs_2d
id = sgs_f512
coarsen_factor = 512
dt = 0.0078125
